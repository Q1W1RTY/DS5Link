+// SPDX-License-Identifier: MIT
+#include <windows.h>
+#include <algorithm>
+#include <cstdlib>
+#include <fstream>
+#include <iostream>
+#include <string>
+#include <vector>
+int main(int argc,char** argv) {
+  if(GetEnvironmentVariableW(L"DS5LINK_MOCK_HIDHIDE_ACCESS_OUTPUT",nullptr,0)>0){std::cout<<"Error code 0x0005 at src\\FilterDriverProxy.cpp(33) Device: access denied\n";return 0;}
+  if(GetEnvironmentVariableW(L"DS5LINK_MOCK_HIDHIDE_ACCESS_EXIT",nullptr,0)>0)return 5;
+  char* path=nullptr;size_t len=0;_dupenv_s(&path,&len,"DS5LINK_MOCK_HIDHIDE_STATE");
+  if(!path)return 3;
+  std::string filename(path);free(path);
+  std::vector<std::string> lines;std::string line;
+  {std::ifstream input(filename);while(std::getline(input,line))lines.push_back(line);}
+  const auto prefix=[](const std::string& value,const std::string& p){return value.rfind(p,0)==0;};
+  for(int i=1;i<argc;++i) {
+    std::string command(argv[i]);
+    if(command=="--inv-off" && GetEnvironmentVariableW(L"DS5LINK_MOCK_IGNORE_INV_OFF",nullptr,0)>0)continue;
+    if(command=="--cloak-state" || command=="--inv-state" || command=="--app-list" || command=="--dev-list") {
+      std::string p=command=="--cloak-state"?"--cloak-":command=="--inv-state"?"--inv-":command=="--app-list"?"--app-reg ":"--dev-hide ";
+      for(const auto& s:lines)if(prefix(s,p))std::cout<<s<<'\n';
+    } else if(command=="--cloak-on" || command=="--cloak-off" || command=="--inv-on" || command=="--inv-off") {
+      const auto key=prefix(command,"--inv-")?"--inv-":"--cloak-";
+      lines.erase(std::remove_if(lines.begin(),lines.end(),[&](const auto& s){return prefix(s,key);}),lines.end());lines.push_back(command);
+    } else if(command=="--app-reg" || command=="--app-unreg" || command=="--dev-hide" || command=="--dev-unhide") {
+      if(++i>=argc)return 4;
+      auto value=(command=="--dev-unhide"?"--dev-hide":command=="--app-unreg"?"--app-reg":command)+std::string(" \"")+argv[i]+"\"";
+      if(command=="--dev-unhide" || command=="--app-unreg")lines.erase(std::remove(lines.begin(),lines.end(),value),lines.end());
+      else if(std::find(lines.begin(),lines.end(),value)==lines.end())lines.push_back(value);
+    } else return 5;
+  }
+  std::ofstream output(filename,std::ios::trunc);for(const auto& s:lines)output<<s<<'\n';return output?0:6;
+}
diff --git a/tests/protocol_tests.cc b/tests/protocol_tests.cc
new file mode 100644
index 0000000..a189654
--- /dev/null
+++ b/tests/protocol_tests.cc
@@ -0,0 +1,81 @@
+#include "platform/win32/hid_input_snapshot.hh"
+// SPDX-License-Identifier: MIT
+#include "vds_protocol.hh"
+#include "vds/ds5_usb.h"
+#include "platform/win32/vds_identity.hh"
+#include <iostream>
+#include <stdexcept>
+
+void check(bool value, const char* message) { if(!value) throw std::runtime_error(message); }
+
+// Slow bitwise reference over the HIDP prefix plus payload, independent of
+// the production lookup table and precomputed seed.
+std::uint32_t reference_crc(std::uint8_t prefix, std::span<const std::uint8_t> bytes) {
+  std::uint32_t crc=0xffffffff;
+  const auto feed=[&](std::uint8_t byte) {
+    crc^=byte;
+    for(int bit=0;bit<8;++bit) crc=(crc>>1)^((crc&1)?0xedb88320:0);
+  };
+  feed(prefix); for(auto byte:bytes) feed(byte); return ~crc;
+}
+
+int main() {
+  try {
+    ds5link::HidInputSnapshot snapshot;
+    const auto neutral=snapshot.report();
+    check(neutral.size()==64 && neutral[0]==1 && neutral[8]==8 && neutral[9]==0 && neutral[10]==0,"Initial HID state has phantom buttons");
+    check(neutral[1]==128 && neutral[2]==128 && neutral[3]==128 && neutral[4]==128 && neutral[5]==0 && neutral[6]==0,"Initial HID axes are not neutral");
+    check(neutral[33]==128 && neutral[37]==128,"Initial HID touches active");
+    auto pressed=neutral;pressed[8]=0x28;
+    check(snapshot.update(pressed) && snapshot.report()==pressed,"Real HID state not retained across input gap");
+    check(!snapshot.update(std::span<const std::uint8_t>(pressed).first(10)) && snapshot.report()==pressed,"Short input replaced complete snapshot");
+    pressed[0]=0x31;
+    check(!snapshot.update(pressed) && snapshot.report()[0]==1,"Bluetooth format leaked into USB snapshot");
+    const auto identity=vds::win::usbip::device_descriptor_with_serial(vds_ds5_usb_device_descriptor);
+    check(identity.size()==18 && identity[16]==3,"USB serial descriptor index");
+    for(unsigned i=0;i<18;++i) if(i!=16) check(identity[i]==vds_ds5_usb_device_descriptor[i],"device identity changed outside serial index");
+    check(vds::win::usbip::stable_virtual_serial(0)!=vds::win::usbip::stable_virtual_serial(1),"port serial collision");
+    std::vector<std::uint8_t> physical_pairing(20,0x7c);physical_pairing[0]=9;
+    auto virtual_pairing=vds::win::usbip::virtual_pairing_identity(physical_pairing,0);
+    check(virtual_pairing.size()==physical_pairing.size() && virtual_pairing[6]==2 && virtual_pairing[1]==1,"virtual pairing address invalid");
+    check(physical_pairing[1]==0x7c && std::equal(virtual_pairing.begin()+7,virtual_pairing.end(),physical_pairing.begin()+7),"pairing rewrite damaged physical or unrelated data");
+    check(virtual_pairing==vds::win::usbip::virtual_pairing_identity(physical_pairing,0) && virtual_pairing!=vds::win::usbip::virtual_pairing_identity(physical_pairing,1),"virtual pairing identity unstable or colliding");
+    physical_pairing[0]=0x20;check(physical_pairing==vds::win::usbip::virtual_pairing_identity(physical_pairing,0),"firmware report identity modified");
+    for(const auto size : {4u,78u,142u,398u}) for(const bool feature : {false,true}) {
+      std::vector<std::uint8_t> report(size);
+      for(unsigned i=0;i<size-4;++i) report[i]=static_cast<std::uint8_t>(i*37+0x31);
+      const auto crc=reference_crc(feature?0x53:0xa2,std::span(report).first(size-4));
+      if(feature) vds::fill_feature_report_checksum(report); else vds::fill_output_report_checksum(report);
+      for(unsigned byte=0;byte<4;++byte) check(report[size-4+byte]==((crc>>(8*byte))&255),"CRC mismatch");
+    }
+    for(unsigned size=0;size<4;++size) {
+      std::vector<std::uint8_t> report(size,0x5a), before=report;
+      bool rejected=false;
+      try { vds::fill_output_report_checksum(report); } catch(const std::invalid_argument&) { rejected=true; }
+      check(rejected && report==before,"short CRC output not rejected safely");
+    }
+    for(unsigned size=0;size<79;++size) {
+      std::vector<std::uint8_t> packet(size,0);
+      if(size>0) packet[0]=0xa1;
+      if(size>1) packet[1]=0x31;
+      if(size>2) packet[2]=0x01;
+      check(!vds::bt_input_to_usb_input(packet),"truncated input accepted");
+    }
+    std::vector<std::uint8_t> packet(79,0);
+    packet[0]=0xa1; packet[1]=0x31; packet[2]=1;
+    packet[3]=0x12; packet[65]=0x34;
+    const auto checksum=[&]{auto crc=reference_crc(0xa1,std::span(packet).subspan(1,packet.size()-5));for(unsigned i=0;i<4;++i)packet[packet.size()-4+i]=static_cast<std::uint8_t>(crc>>(8*i));};
+    checksum();
+    const auto input=vds::bt_input_to_usb_input(packet);
+    check(input && (*input)[0]==1 && (*input)[1]==0x12 && (*input)[63]==0x34,"input translation offsets");
+    packet[40]^=1;check(!vds::bt_input_to_usb_input(packet),"bad input CRC accepted");packet[40]^=1;
+    packet[2]=2;
+    checksum();
+    check(!vds::bt_input_to_usb_input(packet),"microphone interpreted as controls");
+    check(vds::bt_mic_opus_payload(packet).has_value(),"microphone payload missing");
+    packet[40]^=1;check(!vds::bt_mic_opus_payload(packet),"bad microphone CRC accepted");packet[40]^=1;
+    packet.resize(74);
+    check(!vds::bt_mic_opus_payload(packet),"truncated microphone accepted");
+    std::cout << "protocol boundary tests passed\n"; return 0;
+  } catch(const std::exception& e) { std::cerr << e.what() << '\n'; return 1; }
+}
