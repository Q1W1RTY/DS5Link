new file mode 100644
index 0000000..485805c
--- /dev/null
+++ b/tests/audio_queue_tests.cc
@@ -0,0 +1,22 @@
+// SPDX-License-Identifier: MIT
+#include "ds5link_audio_queue.hh"
+#include <iostream>
+#include <stdexcept>
+using namespace std::chrono_literals;
+void check(bool value,const char* message){if(!value)throw std::runtime_error(message);}
+int main(){try{
+ using Item=ds5link::TimedAudioItem<int>;const auto start=std::chrono::steady_clock::time_point{};
+ std::deque<Item> queue;
+ // A stalled sender must never replay a second-old effect, even with a small queue.
+ for(int i=0;i<4;++i)queue.push_back({i,start});
+ check(ds5link::trim_audio_queue(queue,start+1s,8,100ms)==4 && queue.empty(),"stalled effects were replayed");
+ // A fresh impulse behind stale data survives and retains FIFO order.
+ queue={{1,start},{2,start+150ms},{3,start+160ms}};
+ check(ds5link::trim_audio_queue(queue,start+200ms,8,100ms)==1 && queue.front().audio==2 && queue.back().audio==3,"fresh effects were lost or reordered");
+ // Large bursts keep only the newest bounded tail, without dropping fresh silence.
+ queue.clear();for(int i=0;i<20;++i)queue.push_back({i,start+200ms});
+ check(ds5link::trim_audio_queue(queue,start+210ms,8,100ms)==12 && queue.size()==8 && queue.front().audio==12,"burst latency was not bounded");
+ check(ds5link::trim_audio_queue(queue,start+300ms,8,100ms)==0,"age boundary dropped fresh audio");
+ check(ds5link::trim_audio_queue(queue,start+301ms,8,100ms)==8 && queue.empty(),"old tail survived age limit");
+ std::cout<<"audio queue freshness tests passed\n";return 0;
+}catch(const std::exception& e){std::cerr<<e.what()<<'\n';return 1;}}
