@@ -0,0 +1,20 @@
+#pragma once
+#include <array>
+#include <algorithm>
+#include <cstdint>
+#include <span>
+
+namespace ds5link {
+// Protected by the USB/IP demultiplexer mutex. Enumeration can precede
+// the first physical input packet; never complete a poll with empty data.
+class HidInputSnapshot {
+ std::array<std::uint8_t,64> report_{};
+public:
+ HidInputSnapshot(){report_[0]=1;for(unsigned i=1;i<=4;++i)report_[i]=128;report_[8]=8;report_[33]=report_[37]=128;}
+ bool update(std::span<const std::uint8_t> report){
+  if(report.size()!=report_.size() || report[0]!=1)return false;
+  std::copy(report.begin(),report.end(),report_.begin());return true;
+ }
+ const auto& report()const{return report_;}
+};
+}
diff --git a/src/platform/win32/io_deadline.hh b/src/platform/win32/io_deadline.hh
new file mode 100644
index 0000000..2f85759
--- /dev/null
+++ b/src/platform/win32/io_deadline.hh
@@ -0,0 +1,11 @@
+#pragma once
+#include <windows.h>
+namespace ds5link {
+// Caller owns OVERLAPPED and buffer until cancellation has been drained.
+inline DWORD wait_io(HANDLE handle,OVERLAPPED& operation,HANDLE stop,DWORD timeout,DWORD& count){
+ HANDLE waits[]{operation.hEvent,stop};
+ const DWORD result=WaitForMultipleObjects(2,waits,FALSE,timeout);
+ if(result!=WAIT_OBJECT_0){CancelIoEx(handle,&operation);GetOverlappedResult(handle,&operation,&count,TRUE);}
+ return result;
+}
+}
