diff --git a/src/ds5link_audio_queue.hh b/src/ds5link_audio_queue.hh
new file mode 100644
index 0000000..7212192
--- /dev/null
+++ b/src/ds5link_audio_queue.hh
@@ -0,0 +1,21 @@
+// SPDX-License-Identifier: MIT
+#pragma once
+#include <chrono>
+#include <cstddef>
+#include <deque>
+namespace ds5link {
+template<class T> struct TimedAudioItem {
+  T audio;
+  std::chrono::steady_clock::time_point enqueued;
+};
+template<class T> std::size_t trim_audio_queue(
+    std::deque<TimedAudioItem<T>>& queue,
+    std::chrono::steady_clock::time_point now,std::size_t max_blocks,
+    std::chrono::steady_clock::duration max_age) {
+  std::size_t dropped=0;
+  while(!queue.empty() && (queue.size()>max_blocks || now-queue.front().enqueued>max_age)) {
+    queue.pop_front();++dropped;
+  }
+  return dropped;
+}
+}
diff --git a/src/ds5link_effects.hh b/src/ds5link_effects.hh
new file mode 100644
index 0000000..ae4fe7f
--- /dev/null
+++ b/src/ds5link_effects.hh
@@ -0,0 +1,107 @@
+#pragma once
+#include "vds_protocol.hh"
+#include <nlohmann/json.hpp>
+#include <algorithm>
+#include <array>
+#include <cmath>
+#include <cstring>
+#include <optional>
+#include <string>
+
+namespace ds5link::effects {
+// Xbox only owns motor/trigger/LED output; never inherit PS5 audio/power defaults.
+inline vds::DsState xbox_state(unsigned motors,bool release=false){
+ vds::DsState state{};state[0]=release?15:3;
+ state[2]=static_cast<std::uint8_t>(motors);state[3]=static_cast<std::uint8_t>(motors>>8);
+ if(release){state[offsetof(vds_set_state_data,left_trigger_ffb)]=5;state[offsetof(vds_set_state_data,right_trigger_ffb)]=5;}
+ return state;
+}
+inline vds::DsState xbox_led_setup(){
+ vds::DsState state{};state[38]=1;state[offsetof(vds_set_state_data,light_brightness)]=0;return state;
+}
+struct Trigger {
+ std::string mode="game";int strength=3,start=2,end=7,frequency=15;
+};
+struct Options {
+ Trigger left,right;
+ std::string led_mode="game";int red=10,green=132,blue=255,brightness=60,speed=50;
+ bool audio_enabled=false;int sensitivity=100,limit=35,gate=3;bool bass_only=true;
+};
+inline int integer(const nlohmann::json& j,const char* key,int low,int high){
+ const auto& v=j.at(key);if(!v.is_number_integer() || v<low || v>high)throw std::runtime_error(std::string("Invalid effect option: ")+key);return v.get<int>();
+}
+inline Trigger parse_trigger(const nlohmann::json& j){
+ Trigger t;t.mode=j.at("mode").get<std::string>();
+ if(t.mode!="game" && t.mode!="resistance" && t.mode!="weapon" && t.mode!="pulse")throw std::runtime_error("Invalid trigger mode");
+ t.strength=integer(j,"strength",1,8);t.start=integer(j,"start",0,9);t.end=integer(j,"end",1,9);t.frequency=integer(j,"frequency",1,40);
+ if(t.mode=="weapon" && (t.start<2 || t.start>7 || t.end<=t.start || t.end>8))throw std::runtime_error("Invalid weapon trigger range");return t;
+}
+inline Options parse(const nlohmann::json& j){
+ Options o;o.left=parse_trigger(j.at("left"));o.right=parse_trigger(j.at("right"));o.led_mode=j.at("ledMode").get<std::string>();
+ if(o.led_mode!="game" && o.led_mode!="fixed" && o.led_mode!="pulse" && o.led_mode!="rainbow" && o.led_mode!="battery")throw std::runtime_error("Invalid LED mode");
+ o.red=integer(j,"red",0,255);o.green=integer(j,"green",0,255);o.blue=integer(j,"blue",0,255);o.brightness=integer(j,"brightness",1,100);o.speed=integer(j,"speed",1,100);
+ o.audio_enabled=j.at("audioEnabled").get<bool>();o.bass_only=j.at("bassOnly").get<bool>();o.sensitivity=integer(j,"sensitivity",10,300);o.limit=integer(j,"limit",1,80);o.gate=integer(j,"gate",0,20);return o;
+}
+inline nlohmann::json json(const Trigger& t){return {{"mode",t.mode},{"strength",t.strength},{"start",t.start},{"end",t.end},{"frequency",t.frequency}};}
+inline nlohmann::json json(const Options& o){return {{"left",json(o.left)},{"right",json(o.right)},{"ledMode",o.led_mode},{"red",o.red},{"green",o.green},{"blue",o.blue},{"brightness",o.brightness},{"speed",o.speed},{"audioEnabled",o.audio_enabled},{"bassOnly",o.bass_only},{"sensitivity",o.sensitivity},{"limit",o.limit},{"gate",o.gate}};}
+inline bool enabled(const Options& o){return o.left.mode!="game" || o.right.mode!="game" || o.led_mode!="game" || o.audio_enabled;}
+// Official 0x21/0x25/0x26 effect layouts, documented by Nielk1's MIT TriggerEffectGenerator.
+inline std::array<std::uint8_t,11> trigger_bytes(const Trigger& t){
+ std::array<std::uint8_t,11> out{};out[0]=5;if(t.mode=="game")return out;
+ if(t.mode=="weapon"){
+  const auto zones=(1u<<t.start)|(1u<<t.end);out[0]=0x25;out[1]=zones&255;out[2]=zones>>8;out[3]=t.strength-1;return out;
+ }
+ std::uint32_t forces=0;unsigned zones=0;for(int i=t.start;i<10;i++){zones|=1u<<i;forces|=std::uint32_t(t.strength-1)<<(3*i);}
+ out[0]=t.mode=="pulse"?0x26:0x21;out[1]=zones&255;out[2]=zones>>8;
+ for(int i=0;i<4;i++)out[3+i]=(forces>>(8*i))&255;
+ if(t.mode=="pulse")out[9]=t.frequency;return out;
+}
+struct Session {
+ bool left_owned=false,right_owned=false,led_owned=false,rumble_owned=false,native_audio=false;
+ bool left_used=false,right_used=false,led_used=false,audio_used=false;
+ bool led_ready=false;std::int64_t led_init_ms=0;
+ void observe(std::span<const std::uint8_t> report){
+  if(report.size()>=48 && report[0]==2)report=report.subspan(1,47);
+  else if(report.size()!=47)return;
+  right_owned|=(report[0]&4)!=0;left_owned|=(report[0]&8)!=0;
+  led_owned|=(report[1]&12)!=0 || (report[38]&3)!=0;
+  rumble_owned|=(report[0]&3)!=0 || (report[38]&4)!=0;
+ }
+};
+inline std::array<int,3> color(const Options& o,double seconds,std::optional<int> battery){
+ std::array<int,3> c{o.red,o.green,o.blue};double scale=o.brightness/100.0;
+ const double cycle=seconds*(0.05+o.speed/100.0*0.4);
+ if(o.led_mode=="pulse")scale*=0.12+0.88*(0.5-0.5*std::cos(cycle*6.283185307));
+ if(o.led_mode=="rainbow"){
+  const double hue=std::fmod(cycle,1.0)*6;int sector=static_cast<int>(hue);int up=static_cast<int>((hue-sector)*255),down=255-up;
+  switch(sector){case 0:c={255,up,0};break;case 1:c={down,255,0};break;case 2:c={0,255,up};break;case 3:c={0,down,255};break;case 4:c={up,0,255};break;default:c={255,0,down};}
+ }
+ if(o.led_mode=="battery")c=!battery?std::array<int,3>{80,80,80}:*battery<=20?std::array<int,3>{255,45,35}:*battery<=50?std::array<int,3>{255,160,10}:std::array<int,3>{48,209,88};
+ for(auto& v:c)v=static_cast<int>(std::lround(v*scale));return c;
+}
+inline vds::DsState compose(const vds::DsState& base,Session& session,const Options& options,bool live,int audio_level,double seconds,std::optional<int> battery={}){
+ auto out=base;
+ const auto trigger=[&](const Trigger& option,bool owned,bool& used,int offset,unsigned flag){
+  if(owned)return;
+  if(live && option.mode!="game") {auto bytes=trigger_bytes(option);std::copy(bytes.begin(),bytes.end(),out.begin()+offset);out[0]|=flag;used=true;}
+  else if(used){std::fill_n(out.begin()+offset,11,0);out[offset]=5;out[0]|=flag;}
+ };
+ trigger(options.right,session.right_owned,session.right_used,offsetof(vds_set_state_data,right_trigger_ffb),4);
+ trigger(options.left,session.left_owned,session.left_used,offsetof(vds_set_state_data,left_trigger_ffb),8);
+ if(!session.led_owned){
+  if(live && options.led_mode!="game"){
+   session.led_used=true;
+   if(session.led_init_ms!=0 && seconds*1000>=session.led_init_ms)session.led_ready=true;
+   out[1]&=static_cast<std::uint8_t>(~12);out[38]&=static_cast<std::uint8_t>(~3);
+   if(session.led_ready){const auto rgb=color(options,seconds,battery);for(int i=0;i<3;i++)out[offsetof(vds_set_state_data,led_red)+i]=static_cast<std::uint8_t>(rgb[i]);out[1]|=4;}
+  }else if(session.led_used){out[1]|=4;out[38]&=static_cast<std::uint8_t>(~3);}
+ }
+ if(!session.rumble_owned && !session.native_audio && (live && options.audio_enabled || session.audio_used)){
+  // Audio is PCM haptics now; never convert loudness into a sustained rumble.
+  out[0]&=static_cast<std::uint8_t>(~3);out[38]&=static_cast<std::uint8_t>(~4);out[2]=out[3]=0;
+  if(live && options.audio_enabled){out[1]|=2;out[9]&=static_cast<std::uint8_t>(~0x84);session.audio_used=true;}
+ }
+
+ return out;
+}
+}
diff --git a/src/ds5link_input.hh b/src/ds5link_input.hh
new file mode 100644
index 0000000..240e053
--- /dev/null
+++ b/src/ds5link_input.hh
@@ -0,0 +1,101 @@
+#pragma once
+#include <algorithm>
+#include <cmath>
+#include <chrono>
+#include <cstdint>
+#include <optional>
+#include <span>
+
+namespace ds5link {
+class BluetoothIdleTimer {
+ using Clock=std::chrono::steady_clock;
+ static constexpr auto desktop_timeout=std::chrono::minutes(5);
+ static constexpr auto game_timeout=std::chrono::minutes(15);
+ static constexpr auto fresh_for=std::chrono::seconds(1);
+ std::optional<Clock::time_point> last_report_,last_activity_;
+
+ static bool has_activity(std::span<const std::uint8_t> report){
+  // Offsets are for the normalized DualSense report, including Report ID.
+  if((report[8]&15)<8 || (report[8]&0xf0) || report[9] || (report[10]&0xf7))return true;
+  if(!(report[33]&128) || !(report[37]&128))return true;
+  for(unsigned axis=1;axis<=4;++axis)if(std::abs(int(report[axis])-128)>=16)return true;
+  if(report[5]>=8 || report[6]>=8)return true;
+  for(unsigned offset=16;offset<=20;offset+=2){
+   const int raw=report[offset]|(int(report[offset+1])<<8);
+   if(std::abs(raw>=32768?raw-65536:raw)>=512)return true;
+  }
+  return false;
+ }
+public:
+ void observe(std::span<const std::uint8_t> report,Clock::time_point now){
+  if(report.size()<41 || report[0]!=1)return;
+  if(!last_report_ || now-*last_report_>fresh_for || has_activity(report))last_activity_=now;
+  last_report_=now;
+ }
+ bool expired(Clock::time_point now,Clock::time_point game_until=Clock::time_point::min())const{
+  if(!last_report_ || !last_activity_ || now-*last_report_>fresh_for)return false;
+  if(now<game_until)return now-*last_activity_>=game_timeout;
+  // Allow a full desktop timeout after the game loses focus.
+  return now-std::max(*last_activity_,game_until)>=desktop_timeout;
+ }
+};
+
+struct InputOptions {
+ int left_deadzone=0,right_deadzone=0;
+ bool touch_enabled=false,consume_touchpad=true;
+ unsigned touch_click_mask=3; // left=1, right=2; derived from keyboard bindings
+ bool operator==(const InputOptions&) const=default;
+};
+enum class TouchAction {LeftClick,RightClick,Tap,SwipeLeft,SwipeRight,SwipeUp,SwipeDown};
+inline const char* action_name(TouchAction action){
+ switch(action){case TouchAction::LeftClick:return "leftClick";case TouchAction::RightClick:return "rightClick";case TouchAction::Tap:return "tap";case TouchAction::SwipeLeft:return "swipeLeft";case TouchAction::SwipeRight:return "swipeRight";case TouchAction::SwipeUp:return "swipeUp";default:return "swipeDown";}
+}
+inline void deadzone(std::uint8_t& x,std::uint8_t& y,int percent){
+ if(percent==0)return;
+ const auto axis=[](int v){return (v-128)/(v>=128?127.0:128.0);};
+ const double nx=axis(x),ny=axis(y),radius=std::hypot(nx,ny),zone=percent/100.0;
+ if(radius<=zone){x=y=128;return;}
+ const auto encode=[](double v){v=std::clamp(v,-1.0,1.0);return static_cast<std::uint8_t>(std::lround(128+v*(v>=0?127:128)));};
+ const double scale=(radius-zone)/(radius*(1-zone));x=encode(nx*scale);y=encode(ny*scale);
+}
+class InputProcessor {
+ InputOptions previous_{};bool initialized_=false,click_=false,tracking_=false,clicked_=false,multitouch_=false,suppress_click_=false;
+ int id_=0,start_x_=0,start_y_=0,last_x_=0,last_y_=0;std::int64_t started_=0;
+public:
+ std::optional<TouchAction> process(std::span<std::uint8_t> r,const InputOptions& options,std::int64_t now){
+  if(r.size()<41 || r[0]!=1)return {};
+  deadzone(r[1],r[2],options.left_deadzone);deadzone(r[3],r[4],options.right_deadzone);
+  if(!options.touch_enabled){initialized_=tracking_=click_=multitouch_=suppress_click_=false;previous_=options;return {};}
+  // USB report: contact at 33, packed 12-bit X/Y at 34..36; click is byte 10 bit 1.
+  // Layout reference: Linux drivers/hid/hid-playstation.c, dualsense_input_report.
+  const bool active=(r[33]&128)==0,second=(r[37]&128)==0,click=(r[10]&2)!=0;
+  const int id=r[33]&127,x=r[34]|((r[35]&15)<<8),y=(r[35]>>4)|(r[36]<<4);
+  const bool reset=!initialized_ || previous_!=options;
+  previous_=options;std::optional<TouchAction> result;
+  if(reset){initialized_=true;tracking_=false;click_=click;}
+  if(second){tracking_=false;clicked_=true;multitouch_=true;}
+  else if(active && !multitouch_){
+   if(!tracking_ || id_!=id){tracking_=true;id_=id;start_x_=last_x_=x;start_y_=last_y_=y;started_=now;clicked_=click || reset;}
+   last_x_=x;last_y_=y;
+  }
+  if(!reset && click && !click_){result=last_x_<960?TouchAction::LeftClick:TouchAction::RightClick;clicked_=true;}
+  if(!active && tracking_){
+   const int dx=last_x_-start_x_,dy=last_y_-start_y_;const auto duration=now-started_;
+   if(!result && !clicked_ && duration>=30 && duration<=800){
+    if(std::abs(dx)>=240 && std::abs(dx)>std::abs(dy))result=dx<0?TouchAction::SwipeLeft:TouchAction::SwipeRight;
+    else if(std::abs(dy)>=180 && std::abs(dy)>std::abs(dx))result=dy<0?TouchAction::SwipeUp:TouchAction::SwipeDown;
+    else if(std::abs(dx)<80 && std::abs(dy)<80 && duration<=250)result=TouchAction::Tap;
+   }
+   tracking_=false;
+  }
+  if(!active && !second)multitouch_=false;
+  if(click && (!click_ || reset))suppress_click_=(options.touch_click_mask & (last_x_<960?1u:2u))!=0;
+  if(!click)suppress_click_=false;
+  click_=click;
+  // Keep native contacts/gestures and all unassigned controls intact.
+  // Latch the chosen side until release, even if the finger crosses the middle.
+  if(options.consume_touchpad && suppress_click_)r[10]&=static_cast<std::uint8_t>(~2);
+  return result;
+ }
+};
+}
diff --git a/src/ds5link_metrics.hh b/src/ds5link_metrics.hh
new file mode 100644
index 0000000..24ece5f
--- /dev/null
+++ b/src/ds5link_metrics.hh
@@ -0,0 +1,48 @@
+// SPDX-License-Identifier: MIT
+#pragma once
+#include <algorithm>
+#include <chrono>
+#include <cstdint>
+#include <deque>
+#include <optional>
+
+namespace ds5link {
+struct BatteryStatus {std::optional<int> percent;bool charging=false;};
+inline BatteryStatus decode_battery_status(std::uint8_t raw) {
+  const unsigned status=raw>>4,level=raw&15;
+  if(status==2)return {100,false};
+  if(status<=1 && level<=10)return {std::min(100,static_cast<int>(level*10+5)),status==1};
+  return {};
+}
+struct MetricsSnapshot {double packets_per_second=0;std::uint64_t gaps_over_10ms=0;double max_gap_ms=0;double observed_seconds=0;};
+class InputMetrics {
+public:
+  using Clock=std::chrono::steady_clock;
+  void add(Clock::time_point now) {
+    if(!started_) {first_=now;started_=true;}
+    const double gap=last_?std::chrono::duration<double,std::milli>(now-*last_).count():0;
+    last_=now;
+    samples_.push_back({now,gap});
+    if(gap>10)++gaps_;
+    while(!maxima_.empty() && maxima_.back().gap<=gap)maxima_.pop_back();
+    maxima_.push_back({now,gap});
+    prune(now);
+  }
+  MetricsSnapshot snapshot(Clock::time_point now) {
+    prune(now);
+    const double seconds=started_?std::clamp(std::chrono::duration<double>(now-first_).count(),0.0,60.0):0;
+    return {seconds>0?samples_.size()/seconds:0,gaps_,maxima_.empty()?0:maxima_.front().gap,seconds};
+  }
+private:
+  struct Sample{Clock::time_point at;double gap;};
+  void prune(Clock::time_point now) {
+    const auto cutoff=now-std::chrono::seconds(60);
+    while(!samples_.empty() && samples_.front().at<=cutoff){if(samples_.front().gap>10)--gaps_;samples_.pop_front();}
+    while(!maxima_.empty() && maxima_.front().at<=cutoff)maxima_.pop_front();
+  }
+  bool started_=false;Clock::time_point first_{};
+  std::optional<Clock::time_point> last_;
+  std::deque<Sample> samples_,maxima_;
+  std::uint64_t gaps_=0;
+};
+}
diff --git a/src/platform/win32/control_pipe_server.hh b/src/platform/win32/control_pipe_server.hh
new file mode 100644
index 0000000..62644d2
--- /dev/null
+++ b/src/platform/win32/control_pipe_server.hh
@@ -0,0 +1,329 @@
+#pragma once
+// Included inside the daemon namespace; uses its control protocol helpers.
+class ControlPipeServer {
+public:
+  ControlPipeServer(std::string pipe_name, std::string owner_sid, vds::Logger &logger)
+      : logger_(logger), pipe_name_(std::move(pipe_name)),
+        stop_event_(CreateEventA(nullptr, TRUE, FALSE, nullptr)),
+        command_event_(CreateEventA(nullptr, TRUE, FALSE, nullptr)) {
+    if (!stop_event_ || !command_event_) {
+      throw std::runtime_error("failed to create control pipe event: " +
+                               win32_error_message(GetLastError()));
+    }
+    if(owner_sid.empty()) {
+      HANDLE raw_token=nullptr;
+      if(!OpenProcessToken(GetCurrentProcess(),TOKEN_QUERY,&raw_token)) throw std::runtime_error("Cannot query control pipe owner");
+      UniqueHandle token(raw_token);DWORD size=0;GetTokenInformation(token.get(),TokenUser,nullptr,0,&size);
+      std::vector<unsigned char> buffer(size);
+      if(!GetTokenInformation(token.get(),TokenUser,buffer.data(),size,&size)) throw std::runtime_error("Cannot read control pipe owner");
+      LPSTR sid=nullptr;
+      if(!ConvertSidToStringSidA(reinterpret_cast<TOKEN_USER*>(buffer.data())->User.Sid,&sid)) throw std::runtime_error("Cannot encode owner SID");
+      owner_sid=sid;LocalFree(sid);
+    }
+    PSID sid=nullptr;
+    if(!ConvertStringSidToSidA(owner_sid.c_str(),&sid))throw std::runtime_error("Invalid owner SID");
+    LocalFree(sid);
+    const auto sddl="D:P(A;;GA;;;SY)(A;;GA;;;BA)(A;;GRGW;;;"+owner_sid+")";
+    PSECURITY_DESCRIPTOR descriptor=nullptr;
+    if(!ConvertStringSecurityDescriptorToSecurityDescriptorA(sddl.c_str(),SDDL_REVISION_1,&descriptor,nullptr))throw std::runtime_error("Cannot secure control pipe");
+    security_.reset(descriptor);
+    thread_ = std::thread([this] { thread_main(); });
+  }
+
+  ~ControlPipeServer() { stop(); }
+
+  ControlPipeServer(const ControlPipeServer &) = delete;
+  ControlPipeServer &operator=(const ControlPipeServer &) = delete;
+
+  HANDLE command_event() const { return command_event_.get(); }
+  const std::atomic_uint64_t& busy_since() const {return busy_since_;}
+  const std::atomic_uint64_t& unresponsive_since() const {return unresponsive_since_;}
+
+  template <typename Handler> void service_ready(Handler &&handler) {
+    while (true) {
+      std::shared_ptr<ControlRequest> request;
+      {
+        std::lock_guard lock(mutex_);
+        if (requests_.empty()) {
+          ResetEvent(command_event_.get());
+          return;
+        }
+        request = requests_.front();
+        requests_.pop_front();
+      }
+
+      unresponsive_since_=0;
+      if(request->cancelled)continue;
+      std::string reply;
+      if (request->command.empty()) {
+        reply = "{\"OK\":false,\"error\":\"empty command\"}\n";
+      } else {
+        reply = handler(trim_command(request->command));
+      }
+
+      {
+        std::lock_guard lock(request->mutex);
+        request->reply = std::move(reply);
+      }
+      SetEvent(request->done_event.get());
+    }
+  }
+
+  void stop() {
+    if (stop_requested_.exchange(true)) {
+      return;
+    }
+    SetEvent(stop_event_.get());
+    complete_queued_requests("{\"OK\":false,\"error\":\"daemon stopping\"}\n");
+
+    if (thread_.joinable()) {
+      thread_.join();
+    }
+  }
+
+private:
+  struct ControlRequest {
+    std::string command;
+    std::string reply;
+    std::atomic_bool cancelled=false;
+    UniqueHandle done_event;
+    std::mutex mutex;
+  };
+
+  void complete_queued_requests(std::string reply) {
+    std::deque<std::shared_ptr<ControlRequest>> requests;
+    {
+      std::lock_guard lock(mutex_);
+      requests.swap(requests_);
+      ResetEvent(command_event_.get());
+    }
+    for (const auto &request : requests) {
+      {
+        std::lock_guard lock(request->mutex);
+        request->reply = reply;
+      }
+      SetEvent(request->done_event.get());
+    }
+  }
+
+  std::string queue_command(std::string command) {
+    auto request = std::make_shared<ControlRequest>();
+    request->command = std::move(command);
+    request->done_event.reset(CreateEventA(nullptr, TRUE, FALSE, nullptr));
+    if (!request->done_event) {
+      return "{\"OK\":false,\"error\":\"failed to queue command\"}\n";
+    }
+
+    {
+      std::lock_guard lock(mutex_);
+      if (stop_requested_) {
+        return "{\"OK\":false,\"error\":\"daemon stopping\"}\n";
+      }
+      std::uint64_t empty=0;unresponsive_since_.compare_exchange_strong(empty,GetTickCount64());
+      requests_.push_back(request);
+      SetEvent(command_event_.get());
+    }
+
+    HANDLE wait_handles[2] = {request->done_event.get(), stop_event_.get()};
+    const DWORD wait_result =
+        WaitForMultipleObjects(2, wait_handles, FALSE, 4500);
+    if (wait_result != WAIT_OBJECT_0) {
+      request->cancelled=true;
+      return "{\"OK\":false,\"error\":\"control request timed out\"}\n";
+    }
+
+    std::lock_guard lock(request->mutex);
+    return request->reply;
+  }
+
+  void thread_main() {
+    while (!stop_requested_) {
+      SECURITY_ATTRIBUTES attributes{sizeof(attributes),security_.get(),FALSE};
+      UniqueHandle pipe(CreateNamedPipeA(
+          pipe_name_.c_str(), PIPE_ACCESS_DUPLEX | FILE_FLAG_OVERLAPPED | FILE_FLAG_FIRST_PIPE_INSTANCE,
+          PIPE_TYPE_MESSAGE | PIPE_READMODE_MESSAGE | PIPE_WAIT | PIPE_REJECT_REMOTE_CLIENTS, 1, 65536, 65536,
+          0, &attributes));
+      if (!pipe) {
+        logger_.log(vds::LogScope::Control, vds::LogLevel::Error,
+                    "failed to create control pipe " + pipe_name_ + ": " +
+                        win32_error_message(GetLastError()));
+        WaitForSingleObject(stop_event_.get(), 1000);
+        continue;
+      }
+
+      if (!connect_client(pipe.get()) || stop_requested_) {
+        DisconnectNamedPipe(pipe.get());
+        continue;
+      }
+
+      busy_since_=GetTickCount64();
+      handle_client(pipe.get());
+      busy_since_=0;
+      DisconnectNamedPipe(pipe.get());
+    }
+  }
+
+  bool wait_for_pipe_io(HANDLE pipe, OVERLAPPED &overlapped,
+                        DWORD &bytes_transferred, std::string_view label) {
+    HANDLE wait_handles[2] = {overlapped.hEvent, stop_event_.get()};
+    const DWORD wait_result =
+        WaitForMultipleObjects(2, wait_handles, FALSE, label=="control pipe connect"?INFINITE:5000);
+    if (wait_result == WAIT_OBJECT_0 + 1) {
+      CancelIoEx(pipe, &overlapped);
+      (void)GetOverlappedResult(pipe, &overlapped, &bytes_transferred, TRUE);
+      return false;
+    }
+    if (wait_result != WAIT_OBJECT_0) {
+      CancelIoEx(pipe, &overlapped);
+      (void)GetOverlappedResult(pipe, &overlapped, &bytes_transferred, TRUE);
+      if (!stop_requested_) {
+        logger_.log(vds::LogScope::Control, vds::LogLevel::Warn,
+                    std::string(label) +
+                        " wait failed: " + win32_error_message(GetLastError()));
+      }
+      return false;
+    }
+    if (!GetOverlappedResult(pipe, &overlapped, &bytes_transferred, FALSE)) {
+      const DWORD error = GetLastError();
+      if (!stop_requested_ && error != ERROR_NO_DATA &&
+          error != ERROR_BROKEN_PIPE) {
+        logger_.log(vds::LogScope::Control, vds::LogLevel::Warn,
+                    std::string(label) +
+                        " completion failed: " + win32_error_message(error));
+      }
+      return false;
+    }
+    return true;
+  }
+
+  bool connect_client(HANDLE pipe) {
+    UniqueHandle event(CreateEventA(nullptr, TRUE, FALSE, nullptr));
+    if (!event) {
+      logger_.log(vds::LogScope::Control, vds::LogLevel::Error,
+                  "failed to create control pipe connect event: " +
+                      win32_error_message(GetLastError()));
+      return false;
+    }
+
+    OVERLAPPED overlapped{};
+    overlapped.hEvent = event.get();
+    if (ConnectNamedPipe(pipe, &overlapped)) {
+      return true;
+    }
+
+    const DWORD error = GetLastError();
+    if (error == ERROR_PIPE_CONNECTED) {
+      return true;
+    }
+    if (error != ERROR_IO_PENDING) {
+      if (!stop_requested_) {
+        logger_.log(vds::LogScope::Control, vds::LogLevel::Warn,
+                    "control pipe connect failed: " +
+                        win32_error_message(error));
+      }
+      return false;
+    }
+
+    DWORD ignored = 0;
+    return wait_for_pipe_io(pipe, overlapped, ignored, "control pipe connect");
+  }
+
+  std::optional<std::string> read_command(HANDLE pipe) {
+    UniqueHandle event(CreateEventA(nullptr, TRUE, FALSE, nullptr));
+    if (!event) {
+      logger_.log(vds::LogScope::Control, vds::LogLevel::Error,
+                  "failed to create control pipe read event: " +
+                      win32_error_message(GetLastError()));
+      return std::nullopt;
+    }
+
+    std::string line;
+    const auto deadline=GetTickCount64()+5000;
+    while(line.size()<65536 && GetTickCount64()<deadline) {
+      std::array<char,4096> buffer{};DWORD got=0;
+      OVERLAPPED overlapped{};overlapped.hEvent=event.get();ResetEvent(event.get());
+      BOOL started=ReadFile(pipe,buffer.data(),static_cast<DWORD>(buffer.size()),&got,&overlapped);
+      DWORD error=started?ERROR_SUCCESS:GetLastError();
+      if(!started && error==ERROR_IO_PENDING) {
+        HANDLE handles[]{event.get(),stop_event_.get()};
+        const auto now=GetTickCount64();
+        auto wait=WaitForMultipleObjects(2,handles,FALSE,now>=deadline?0:static_cast<DWORD>(deadline-now));
+        if(wait!=WAIT_OBJECT_0) {CancelIoEx(pipe,&overlapped);GetOverlappedResult(pipe,&overlapped,&got,TRUE);return std::nullopt;}
+        started=GetOverlappedResult(pipe,&overlapped,&got,FALSE);error=started?ERROR_SUCCESS:GetLastError();
+      }
+      if((!started && error!=ERROR_MORE_DATA) || !got)return std::nullopt;
+      line.append(buffer.data(),got);
+      if(line.size()>65536)return std::nullopt;
+      if(line.find('\n')!=std::string::npos)return line;
+    }
+    return std::nullopt;
+  }
+
+  bool write_reply(HANDLE pipe, const std::string &reply) {
+    UniqueHandle event(CreateEventA(nullptr, TRUE, FALSE, nullptr));
+    if (!event) {
+      logger_.log(vds::LogScope::Control, vds::LogLevel::Error,
+                  "failed to create control pipe write event: " +
+                      win32_error_message(GetLastError()));
+      return false;
+    }
+
+    DWORD written = 0;
+    OVERLAPPED overlapped{};
+    overlapped.hEvent = event.get();
+    const BOOL started =
+        WriteFile(pipe, reply.data(), static_cast<DWORD>(reply.size()),
+                  &written, &overlapped);
+    if (!started) {
+      const DWORD error = GetLastError();
+      if (error != ERROR_IO_PENDING) {
+        if (!stop_requested_) {
+          logger_.log(vds::LogScope::Control, vds::LogLevel::Warn,
+                      "control pipe reply failed: " +
+                          win32_error_message(error));
+        }
+        return false;
+      }
+      if (!wait_for_pipe_io(pipe, overlapped, written, "control pipe reply")) {
+        return false;
+      }
+    }
+    return true;
+  }
+
+  void handle_client(HANDLE pipe) {
+    const auto command = read_command(pipe);
+    if (!command) {
+      return;
+    }
+
+    const std::string reply = queue_command(*command);
+    if(write_reply(pipe, reply)) {
+      // DisconnectNamedPipe discards unread output. Drain it with a bounded
+      // synchronous flush so a slow client cannot hold the service forever.
+      UniqueHandle finished(CreateEventA(nullptr,TRUE,FALSE,nullptr));
+      HANDLE raw_thread=nullptr;
+      if(finished && DuplicateHandle(GetCurrentProcess(),GetCurrentThread(),GetCurrentProcess(),&raw_thread,0,FALSE,DUPLICATE_SAME_ACCESS)) {
+        UniqueHandle current_thread(raw_thread);
+        std::thread watchdog([&] {
+          HANDLE handles[]{finished.get(),stop_event_.get()};
+          if(WaitForMultipleObjects(2,handles,FALSE,5000)!=WAIT_OBJECT_0)CancelSynchronousIo(current_thread.get());
+        });
+        FlushFileBuffers(pipe);SetEvent(finished.get());watchdog.join();
+      }
+    }
+  }
+
+  vds::Logger &logger_;
+  std::string pipe_name_;
+  struct LocalDeleter {void operator()(void* value)const {if(value)LocalFree(value);}};
+  std::unique_ptr<void,LocalDeleter> security_;
+  UniqueHandle stop_event_;
+  UniqueHandle command_event_;
+  std::thread thread_;
+  std::atomic_bool stop_requested_ = false;
+  std::atomic_uint64_t busy_since_{0},unresponsive_since_{0};
+  std::mutex mutex_;
+  std::deque<std::shared_ptr<ControlRequest>> requests_;
+};
+
diff --git a/src/platform/win32/ds5link_effects_runtime.hh b/src/platform/win32/ds5link_effects_runtime.hh
new file mode 100644
index 0000000..9be83d4
--- /dev/null
+++ b/src/platform/win32/ds5link_effects_runtime.hh
@@ -0,0 +1,44 @@
+#pragma once
+#include "ds5link_effects.hh"
+#include "vds_fs.hh"
+#include <chrono>
+#include <deque>
+#include <mutex>
+namespace ds5link::effects::runtime {
+using Clock=std::chrono::steady_clock;
+inline std::mutex mutex;inline Options options;inline std::filesystem::path settings_path;
+inline Clock::time_point heartbeat{},audio_time{};inline Session status;inline std::optional<int> battery_value;
+inline std::array<int,3> led_rgb{};inline int audio_level=0,wave_peak=0;inline std::uint64_t wave_sent=0,wave_dropped=0;
+struct Wave {vds::HapticsChunk samples;Clock::time_point captured;};inline std::deque<Wave> waves;
+inline bool lease(Clock::time_point now){return heartbeat!=Clock::time_point{} && now-heartbeat<std::chrono::milliseconds(500);}
+inline void configure(const std::string& path){std::lock_guard guard(mutex);settings_path=std::filesystem::path(std::u8string(reinterpret_cast<const char8_t*>(path.data()),path.size()));if(std::filesystem::exists(settings_path) && std::filesystem::file_size(settings_path)>8192)throw std::runtime_error("Effects file is too large");auto value=vds::read_file_if_exists(settings_path);if(!value.empty())options=parse(nlohmann::json::parse(value));}
+inline void update(const nlohmann::json& value){auto next=parse(value);std::filesystem::path path;{std::lock_guard guard(mutex);path=settings_path;}vds::write_file_atomic(path,json(next).dump());std::lock_guard guard(mutex);
+ bool changed=options.audio_enabled!=next.audio_enabled || options.bass_only!=next.bass_only || options.limit!=next.limit || options.sensitivity!=next.sensitivity || options.gate!=next.gate;
+ options=next;if(changed){waves.clear();audio_time={};audio_level=0;}
+}
+inline void push_frames(const nlohmann::json& frames,std::uint64_t uptime){
+ if(frames.is_null())return;if(!frames.is_array() || frames.size()>4)throw std::runtime_error("Invalid haptic frame batch");
+ std::deque<Wave> accepted;auto now=Clock::now();
+ for(const auto& f:frames){const auto& data=f.at("samples");const auto& tick=f.at("tick");if(!data.is_array() || data.size()!=vds::kHapticsSampleSize || !tick.is_number_integer() || tick<0)throw std::runtime_error("Invalid haptic frame");
+  auto stamp=tick.get<std::uint64_t>();Wave frame{};for(std::size_t i=0;i<data.size();i++){if(!data[i].is_number_integer() || data[i]<-127 || data[i]>127)throw std::runtime_error("Invalid haptic sample");frame.samples[i]=data[i].get<std::int8_t>();}
+  if(stamp==0 || stamp>uptime || uptime-stamp>=80)continue;frame.captured=now-std::chrono::milliseconds(uptime-stamp);accepted.push_back(frame);
+ }
+ std::lock_guard guard(mutex);if(!options.audio_enabled)return;
+ for(auto& frame:accepted){int limit=options.limit*127/100;for(auto& sample:frame.samples)sample=static_cast<std::int8_t>(std::clamp<int>(sample,-limit,limit));while(waves.size()>=4){waves.pop_front();wave_dropped++;}audio_time=frame.captured;waves.push_back(frame);}
+}
+inline nlohmann::json current(bool renew=false,int level=0,int age=0){std::lock_guard guard(mutex);const auto now=Clock::now();if(renew){heartbeat=now;audio_level=age<150?std::clamp(level,0,80):0;}
+ return {{"ledRgb",led_rgb},{"renderedRumble",0},{"wavePeak",wave_peak},{"waveQueued",waves.size()},{"waveSent",wave_sent},{"waveDropped",wave_dropped},{"receivedAudioLevel",audio_level},{"audioAgeMs",audio_time==Clock::time_point{}?-1:std::chrono::duration_cast<std::chrono::milliseconds>(now-audio_time).count()},{"batteryPercent",battery_value?nlohmann::json(*battery_value):nlohmann::json(nullptr)},{"options",json(options)},{"leftOwned",status.left_owned},{"rightOwned",status.right_owned},{"ledOwned",status.led_owned},{"rumbleOwned",status.rumble_owned || status.native_audio},{"leaseActive",lease(now)}};
+}
+inline void clear_status(){std::lock_guard guard(mutex);status={};battery_value={};led_rgb={};audio_level=wave_peak=0;waves.clear();audio_time={};wave_sent=wave_dropped=0;}
+inline vds::DsState render(const vds::DsState& base,Session& session,std::optional<int> battery={},bool audio_supported=true){std::lock_guard guard(mutex);auto now=Clock::now();battery_value=battery;auto active_options=options;if(!audio_supported)active_options.audio_enabled=false;auto rendered=compose(base,session,active_options,lease(now),0,std::chrono::duration<double>(now.time_since_epoch()).count(),battery);status=session;for(int i=0;i<3;i++)led_rgb[i]=rendered[offsetof(vds_set_state_data,led_red)+i];return rendered;}
+inline bool needs_led_init(const Session& session){std::lock_guard guard(mutex);return lease(Clock::now()) && options.led_mode!="game" && !session.led_owned && !session.led_ready && session.led_init_ms==0;}
+inline std::optional<vds::HapticsChunk> take_wave(const Session& session,bool& was_active){
+ std::lock_guard guard(mutex);auto now=Clock::now();bool owned=session.rumble_owned || session.native_audio;
+ bool allowed=lease(now) && options.audio_enabled && !owned;
+ while(!waves.empty() && now-waves.front().captured>=std::chrono::milliseconds(80)){waves.pop_front();wave_dropped++;}
+ if(!allowed){waves.clear();if(was_active && !owned){was_active=false;wave_peak=0;return vds::HapticsChunk{};}was_active=false;return {};}
+ if(!waves.empty()){auto chunk=waves.front().samples;waves.pop_front();was_active=true;wave_peak=0;for(auto sample:chunk)wave_peak=std::max(wave_peak,std::abs(int(sample))*100/127);return chunk;}
+ if(was_active && (audio_time==Clock::time_point{} || now-audio_time>=std::chrono::milliseconds(35))){was_active=false;wave_peak=0;return vds::HapticsChunk{};}return {};
+}
+inline void sent_wave(){std::lock_guard guard(mutex);wave_sent++;}
+}
diff --git a/src/platform/win32/ds5link_input_runtime.hh b/src/platform/win32/ds5link_input_runtime.hh
new file mode 100644
index 0000000..03f29a6
--- /dev/null
+++ b/src/platform/win32/ds5link_input_runtime.hh
@@ -0,0 +1,62 @@
+#pragma once
+#include "ds5link_input.hh"
+#include "vds_fs.hh"
+#include <nlohmann/json.hpp>
+#include <chrono>
+#include <deque>
+#include <array>
+#include <mutex>
+
+namespace ds5link::input {
+using Clock=std::chrono::steady_clock;
+inline std::mutex mutex;
+inline InputOptions options;
+inline std::filesystem::path settings_path;
+struct Event {std::uint64_t sequence;TouchAction action;Clock::time_point time;};
+inline std::deque<Event> events;
+inline std::uint64_t sequence=0;
+inline Clock::time_point heartbeat{},sample_time{};
+inline std::array<std::uint8_t,41> sample{};
+inline const std::string epoch=std::to_string(Clock::now().time_since_epoch().count());
+inline nlohmann::json json(const InputOptions& o){return {{"leftDeadzone",o.left_deadzone},{"rightDeadzone",o.right_deadzone},{"touchEnabled",o.touch_enabled},{"consumeTouchpad",o.consume_touchpad},{"touchClickMask",o.touch_click_mask}};}
+inline InputOptions parse(const nlohmann::json& j){
+ if(!j.is_object() || !j.at("leftDeadzone").is_number_integer() || !j.at("rightDeadzone").is_number_integer() || !j.at("touchEnabled").is_boolean() || !j.at("consumeTouchpad").is_boolean())throw std::runtime_error("INVALID_INPUT_OPTIONS");
+ if(j.at("leftDeadzone")<0 || j.at("leftDeadzone")>30 || j.at("rightDeadzone")<0 || j.at("rightDeadzone")>30)throw std::runtime_error("INVALID_INPUT_OPTIONS");
+ InputOptions o{j.at("leftDeadzone").get<int>(),j.at("rightDeadzone").get<int>(),j.at("touchEnabled").get<bool>(),j.at("consumeTouchpad").get<bool>()};
+ if(o.left_deadzone<0 || o.left_deadzone>30 || o.right_deadzone<0 || o.right_deadzone>30)throw std::runtime_error("INVALID_INPUT_OPTIONS");
+ if(j.contains("touchClickMask")){
+  if(!j.at("touchClickMask").is_number_integer() || j.at("touchClickMask")<0 || j.at("touchClickMask")>3)throw std::runtime_error("INVALID_INPUT_OPTIONS");
+  o.touch_click_mask=j.at("touchClickMask").get<unsigned>();
+ }
+ return o;
+}
+inline void configure(const std::string& path){
+ std::lock_guard guard(mutex);settings_path=std::filesystem::path(std::u8string(reinterpret_cast<const char8_t*>(path.data()),path.size()));
+ if(std::filesystem::exists(settings_path) && std::filesystem::file_size(settings_path)>4096)throw std::runtime_error("Input options file is too large");
+ const auto text=vds::read_file_if_exists(settings_path);if(!text.empty())options=parse(nlohmann::json::parse(text));
+}
+inline nlohmann::json current(){std::lock_guard guard(mutex);return json(options);}
+inline void update(const nlohmann::json& value){
+ auto next=parse(value);std::filesystem::path path;{std::lock_guard guard(mutex);path=settings_path;}
+ vds::write_file_atomic(path,json(next).dump());std::lock_guard guard(mutex);options=next;events.clear();heartbeat={};
+}
+inline void process(InputProcessor& processor,std::span<std::uint8_t> report){
+ const auto now=Clock::now();std::lock_guard guard(mutex);auto effective=options;
+ if(report.size()>=sample.size() && report[0]==1){std::copy_n(report.begin(),sample.size(),sample.begin());sample_time=now;}
+ effective.touch_enabled=options.touch_enabled && heartbeat!=Clock::time_point{} && now-heartbeat<std::chrono::milliseconds(500);
+ const auto action=processor.process(report,effective,std::chrono::duration_cast<std::chrono::milliseconds>(now.time_since_epoch()).count());
+ if(action){events.push_back({++sequence,*action,now});while(events.size()>64)events.pop_front();}
+}
+// Preview is read-only: it must not renew the touch-mapping heartbeat.
+inline nlohmann::json preview(){
+ std::lock_guard guard(mutex);
+ const auto age=sample_time==Clock::time_point{}?-1:std::chrono::duration_cast<std::chrono::milliseconds>(Clock::now()-sample_time).count();
+ auto contact=[&](int offset){return nlohmann::json{{"active",(sample[offset]&128)==0},{"x",sample[offset+1]|((sample[offset+2]&15)<<8)},{"y",(sample[offset+2]>>4)|(sample[offset+3]<<4)}};};
+ return {{"ageMs",age},{"leftX",sample[1]},{"leftY",sample[2]},{"rightX",sample[3]},{"rightY",sample[4]},{"click",(sample[10]&2)!=0},{"touches",nlohmann::json::array({contact(33),contact(37)})}};
+}
+inline nlohmann::json read_events(std::uint64_t after){
+ std::lock_guard guard(mutex);const auto now=Clock::now();heartbeat=now;nlohmann::json rows=nlohmann::json::array();
+ for(const auto& event:events)if(event.sequence>after)rows.push_back({{"sequence",event.sequence},{"action",action_name(event.action)},{"ageMs",std::chrono::duration_cast<std::chrono::milliseconds>(now-event.time).count()}});
+ return {{"epoch",epoch},{"sequence",sequence},{"events",rows}};
+}
+}
diff --git a/src/platform/win32/ds5link_recovery.hh b/src/platform/win32/ds5link_recovery.hh
new file mode 100644
index 0000000..a2024ac
--- /dev/null
+++ b/src/platform/win32/ds5link_recovery.hh
@@ -0,0 +1,41 @@
+#pragma once
+#include <atomic>
+#include <algorithm>
+#include <fstream>
+#include <thread>
+#include <nlohmann/json.hpp>
+#include "unique_handle.hh"
+namespace ds5link::recovery {
+inline bool overdue(std::uint64_t now,std::uint64_t last,std::uint64_t timeout){return now>=last && now-last>=timeout;}
+inline int next_attempt(std::uint64_t now,std::uint64_t previous,int count){return now>=previous && now-previous<300000?std::clamp(count,0,3)+1:1;}
+class Watchdog {
+ std::atomic_uint64_t progress{GetTickCount64()};std::atomic<const char*> phase{"startup"};
+ const std::atomic_uint64_t& control_busy;std::string db;vds::win::UniqueHandle stop{CreateEventW(nullptr,TRUE,FALSE,nullptr)};std::thread thread;std::uint64_t timeout;const std::atomic_uint64_t* pending;
+public:
+ Watchdog(std::string path,const std::atomic_uint64_t& busy,std::uint64_t timeout_ms=15000,const std::atomic_uint64_t* queued=nullptr):control_busy(busy),db(std::move(path)),timeout(timeout_ms),pending(queued){
+  if(!stop)throw std::runtime_error("Cannot start recovery watchdog");
+  thread=std::thread([this]{while(WaitForSingleObject(stop.get(),250)==WAIT_TIMEOUT){
+   const auto now=GetTickCount64(),last=progress.load(),busy=control_busy.load(),queued=pending?pending->load():0;
+   if(queued && overdue(now,queued,timeout)){fail("control queue starved");return;}
+   if(!overdue(now,last,timeout) && !(busy && overdue(now,busy,timeout)))continue;
+   fail(busy && overdue(now,busy,timeout)?"control pipe":phase.load());return;
+  }});
+ }
+ void fail(const char* cause){const auto now=GetTickCount64();
+   // Independent file/Win32 I/O: a stalled logger or supervisor mutex must
+   // not prevent recovery. The SCM restarts only this registered service.
+   try{
+    int attempt=1;std::ifstream previous(db+".recovery-status.json");nlohmann::json old;
+    if(previous.good())try{previous>>old;attempt=next_attempt(now,old.value("uptime",std::uint64_t{}),old.value("attempt",0));}catch(...){}
+    bool paused=attempt>=3;
+    nlohmann::json record{{"reason","service_stalled"},{"phase",cause},{"uptime",now},{"attempt",attempt},{"paused",paused}};
+    std::ofstream status(db+".recovery-status.json",std::ios::trunc);status<<record.dump();status.close();
+    if(paused){std::ofstream marker(db+".paused");marker<<"Automatic recovery stopped after repeated service stalls\n";}
+   }catch(...){}
+   TerminateProcess(GetCurrentProcess(),ERROR_TIMEOUT);
+
+ }
+ void beat(const char* value){phase=value;progress=GetTickCount64();}
+ ~Watchdog(){SetEvent(stop.get());if(thread.joinable())thread.join();}
+};
+}
diff --git a/src/platform/win32/ds5link_usb.hh b/src/platform/win32/ds5link_usb.hh
new file mode 100644
index 0000000..25aa9b5
--- /dev/null
+++ b/src/platform/win32/ds5link_usb.hh
@@ -0,0 +1,76 @@
+#pragma once
+#include <windows.h>
+#include <setupapi.h>
+#include <algorithm>
+#include <array>
+#include <cctype>
+#include <span>
+#include <string>
+#include <stdexcept>
+#include <vector>
+#include "unique_handle.hh"
+#include "vds_win32.hh"
+#include "vds_protocol.hh"
+#include <hidsdi.h>
+#include <hidpi.h>
+#include <cfgmgr32.h>
+namespace ds5link::usb {
+using vds::win::UniqueHandle;
+using vds::win::win32_error_message;
+inline bool safe_visibility_fallback(std::string_view error){return error=="Enabling HidHide would affect other configured devices; configuration was not changed";}
+inline bool physical_ancestry(const std::vector<std::string>& ids){
+ bool physical=false;
+ for(auto value:ids){std::transform(value.begin(),value.end(),value.begin(),[](unsigned char c){return std::toupper(c);});
+  if((value.find("DS5LINK-DUALSENSE-PORT-")!=std::string::npos || value.find("DSEMU-DUALSENSE-PORT-")!=std::string::npos) || value.find("USBIP")!=std::string::npos)return false;
+  if(value.rfind("USB\\VID_054C&PID_0CE6\\",0)==0)physical=true;
+ }
+ return physical;
+}
+inline std::array<std::uint8_t,48> output_report(const vds::DsState& state){std::array<std::uint8_t,48> report{};report[0]=2;std::copy_n(state.begin(),47,report.begin()+1);return report;}
+// Physical USB gamepad collection only. Virtual USB/IP DualSense instances
+// must never become our input (otherwise Xbox would feed back into itself).
+struct UsbDualSense {std::string path,instance;};
+inline std::vector<UsbDualSense> usb_dualsense_devices(){
+ std::vector<UsbDualSense> result;GUID guid{};HidD_GetHidGuid(&guid);
+ auto set=SetupDiGetClassDevsA(&guid,nullptr,nullptr,DIGCF_PRESENT|DIGCF_DEVICEINTERFACE);
+ if(set==INVALID_HANDLE_VALUE)throw std::runtime_error("Cannot enumerate USB controllers");
+ struct Cleanup {HDEVINFO value;~Cleanup(){SetupDiDestroyDeviceInfoList(value);}} cleanup{set};
+ for(DWORD n=0;;n++){
+  SP_DEVICE_INTERFACE_DATA iface{sizeof(iface)};
+  if(!SetupDiEnumDeviceInterfaces(set,nullptr,&guid,n,&iface)){if(GetLastError()==ERROR_NO_MORE_ITEMS)break;throw std::runtime_error("USB HID enumeration failed");}
+  DWORD needed=0;SetupDiGetDeviceInterfaceDetailA(set,&iface,nullptr,0,&needed,nullptr);if(!needed)continue;
+  std::vector<unsigned char> buffer(needed);auto detail=reinterpret_cast<PSP_DEVICE_INTERFACE_DETAIL_DATA_A>(buffer.data());detail->cbSize=sizeof(*detail);SP_DEVINFO_DATA info{sizeof(info)};
+  if(!SetupDiGetDeviceInterfaceDetailA(set,&iface,detail,needed,nullptr,&info))continue;
+  std::string path=detail->DevicePath,lower=path;std::transform(lower.begin(),lower.end(),lower.begin(),[](unsigned char c){return std::tolower(c);});
+  if(lower.find("vid_054c&pid_0ce6")==std::string::npos)continue;
+  std::vector<std::string> ancestors;DEVINST node=info.DevInst;
+  for(int depth=0;depth<12;depth++){
+   char id[MAX_DEVICE_ID_LEN]{};if(CM_Get_Device_IDA(node,id,sizeof(id),0)!=CR_SUCCESS)break;
+   ancestors.emplace_back(id);
+   DEVINST parent;if(CM_Get_Parent(&parent,node,0)!=CR_SUCCESS)break;node=parent;
+  }
+  if(!physical_ancestry(ancestors))continue;
+  UniqueHandle query(CreateFileA(path.c_str(),0,FILE_SHARE_READ|FILE_SHARE_WRITE,nullptr,OPEN_EXISTING,0,nullptr));if(!query)continue;
+  HIDD_ATTRIBUTES attr{sizeof(attr)};if(!HidD_GetAttributes(query.get(),&attr) || attr.VendorID!=0x054c || attr.ProductID!=0x0ce6)continue;
+  PHIDP_PREPARSED_DATA preparsed=nullptr;if(!HidD_GetPreparsedData(query.get(),&preparsed))continue;HIDP_CAPS caps{};auto status=HidP_GetCaps(preparsed,&caps);HidD_FreePreparsedData(preparsed);
+  if(status!=HIDP_STATUS_SUCCESS || caps.UsagePage!=1 || caps.Usage!=5 || caps.InputReportByteLength!=64 || caps.OutputReportByteLength!=48)continue;
+  char instance[MAX_DEVICE_ID_LEN]{};if(SetupDiGetDeviceInstanceIdA(set,&info,instance,sizeof(instance),nullptr))result.push_back({path,instance});
+ }
+ return result;
+}
+class UsbGamepad {
+ UniqueHandle handle;
+public:
+ explicit UsbGamepad(const std::string& path):handle(CreateFileA(path.c_str(),GENERIC_READ|GENERIC_WRITE,FILE_SHARE_READ|FILE_SHARE_WRITE,nullptr,OPEN_EXISTING,FILE_FLAG_OVERLAPPED,nullptr)){if(!handle)throw std::runtime_error("Cannot open USB DualSense: "+win32_error_message(GetLastError()));HidD_SetNumInputBuffers(handle.get(),8);}
+ // Cancel and drain before OVERLAPPED/buffer leave scope, including unplug/stop.
+ DWORD transfer(bool write,std::span<std::uint8_t> data,DWORD timeout){
+  UniqueHandle event(CreateEventW(nullptr,TRUE,FALSE,nullptr));if(!event)throw std::runtime_error("USB I/O event failed");OVERLAPPED op{};op.hEvent=event.get();DWORD count=0;
+  BOOL done=write?WriteFile(handle.get(),data.data(),static_cast<DWORD>(data.size()),&count,&op):ReadFile(handle.get(),data.data(),static_cast<DWORD>(data.size()),&count,&op);
+  if(!done){if(GetLastError()!=ERROR_IO_PENDING)throw std::runtime_error("USB DualSense I/O failed: "+win32_error_message(GetLastError()));auto wait=WaitForSingleObject(event.get(),timeout);if(wait!=WAIT_OBJECT_0){CancelIoEx(handle.get(),&op);GetOverlappedResult(handle.get(),&op,&count,TRUE);if(!write && wait==WAIT_TIMEOUT)return 0;throw std::runtime_error("USB DualSense output timed out");}if(!GetOverlappedResult(handle.get(),&op,&count,FALSE))throw std::runtime_error("USB DualSense disconnected");}
+  return count;
+ }
+ DWORD read(std::span<std::uint8_t> data){return transfer(false,data,20);}
+ void write(const vds::DsState& state){auto report=output_report(state);if(transfer(true,report,200)!=report.size())throw std::runtime_error("Short USB DualSense output");}
+};
+
+} // namespace ds5link::usb
diff --git a/src/platform/win32/ds5link_xbox.hh b/src/platform/win32/ds5link_xbox.hh
new file mode 100644
index 0000000..9e2ad4f
--- /dev/null
+++ b/src/platform/win32/ds5link_xbox.hh
@@ -0,0 +1,79 @@
+#pragma once
+#include <cstdint>
+#include <windows.h>
+#include <ViGEm/Client.h>
+#include <atomic>
+#include <span>
+#include <stdexcept>
+
+namespace ds5link {
+inline XUSB_REPORT xbox_report(std::span<const std::uint8_t> r) {
+  if(r.size()<11)throw std::runtime_error("Short DualSense input report");
+  XUSB_REPORT out{};
+  const auto axis=[](int v,bool invert=false)->SHORT {
+    int n=v>=128?(v-128)*32767/127:(v-128)*256;
+    return static_cast<SHORT>(invert ? (n==-32768?32767:-n) : n);
+  };
+  out.sThumbLX=axis(r[1]);out.sThumbLY=axis(r[2],true);
+  out.sThumbRX=axis(r[3]);out.sThumbRY=axis(r[4],true);
+  out.bLeftTrigger=r[5];out.bRightTrigger=r[6];
+  constexpr USHORT hats[]={1,9,8,10,2,6,4,5,0};
+  out.wButtons=hats[(r[8]&15)<=8?(r[8]&15):8];
+  if(r[8]&0x10)out.wButtons|=XUSB_GAMEPAD_X;
+  if(r[8]&0x20)out.wButtons|=XUSB_GAMEPAD_A;
+  if(r[8]&0x40)out.wButtons|=XUSB_GAMEPAD_B;
+  if(r[8]&0x80)out.wButtons|=XUSB_GAMEPAD_Y;
+  if(r[9]&1)out.wButtons|=XUSB_GAMEPAD_LEFT_SHOULDER;
+  if(r[9]&2)out.wButtons|=XUSB_GAMEPAD_RIGHT_SHOULDER;
+  if(r[9]&0x10)out.wButtons|=XUSB_GAMEPAD_BACK;
+  if(r[9]&0x20)out.wButtons|=XUSB_GAMEPAD_START;
+  if(r[9]&0x40)out.wButtons|=XUSB_GAMEPAD_LEFT_THUMB;
+  if(r[9]&0x80)out.wButtons|=XUSB_GAMEPAD_RIGHT_THUMB;
+  if(r[10]&1)out.wButtons|=XUSB_GAMEPAD_GUIDE;
+  return out;
+}
+class XboxTarget {
+  PVIGEM_CLIENT client_=nullptr;
+  PVIGEM_TARGET target_=nullptr;
+  bool added_=false, notified_=false;
+  std::atomic_uint motors_{0};
+  std::atomic_bool feedback_received_{false};
+  static void CALLBACK feedback(PVIGEM_CLIENT,PVIGEM_TARGET,UCHAR largeMotor,UCHAR smallMotor,UCHAR,LPVOID context) {
+    static_cast<XboxTarget*>(context)->feedback_received_=true;
+    static_cast<XboxTarget*>(context)->motors_.store((unsigned(largeMotor)<<8)|smallMotor);
+  }
+  void release() noexcept {
+    if(target_){
+      if(notified_)vigem_target_x360_unregister_notification(target_);
+      if(added_){vigem_target_x360_update(client_,target_,XUSB_REPORT{});vigem_target_remove(client_,target_);}
+      vigem_target_free(target_);
+    }
+    if(client_){vigem_disconnect(client_);vigem_free(client_);}
+  }
+public:
+  static bool available() {
+    auto c=vigem_alloc();if(!c)return false;
+    const bool ok=VIGEM_SUCCESS(vigem_connect(c));
+    vigem_disconnect(c);vigem_free(c);return ok;
+  }
+  XboxTarget() {
+    try {
+      client_=vigem_alloc();
+      if(!client_ || !VIGEM_SUCCESS(vigem_connect(client_)))throw std::runtime_error("ViGEmBus unavailable. Install the Xbox driver using DS5Link Setup.");
+      target_=vigem_target_x360_alloc();
+      if(!target_ || !VIGEM_SUCCESS(vigem_target_add(client_,target_)))throw std::runtime_error("Cannot create Xbox 360 controller");
+      added_=true;
+      if(!VIGEM_SUCCESS(vigem_target_x360_register_notification(client_,target_,feedback,this)))throw std::runtime_error("Cannot register Xbox vibration");
+      notified_=true;
+    }catch(...){release();throw;}
+  }
+  ~XboxTarget(){release();}
+  XboxTarget(const XboxTarget&)=delete;
+  XboxTarget& operator=(const XboxTarget&)=delete;
+  bool feedback_received() const {return feedback_received_.load();}
+  unsigned motors() const {return motors_.load();}
+  void update(std::span<const std::uint8_t> report) {
+    if(!VIGEM_SUCCESS(vigem_target_x360_update(client_,target_,xbox_report(report))))throw std::runtime_error("Xbox input submission failed");
+  }
+};
+}
diff --git a/src/platform/win32/hid_input_snapshot.hh b/src/platform/win32/hid_input_snapshot.hh
new file mode 100644
index 0000000..043c4a5
