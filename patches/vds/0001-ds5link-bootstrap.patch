+// Included inside the daemon namespace to share transport and telemetry helpers.
+void run_xbox_session(const std::string& address, vds::Logger& logger,
+                      std::atomic_bool& stop) {
+  ds5link::XboxTarget xbox;
+  ds5link::InputProcessor input_processor;
+  std::string error;
+  auto device=find_connected_bluetooth_device(address,&error);
+  if(!device)throw std::runtime_error(error);
+  auto hidden=vds::win::hidhide::hide_device(device->instance_path,logger);
+  auto bluetooth=make_hid_bluetooth_transport(address);
+  g_telemetry.clear();
+  ds5link::effects::runtime::clear_status();
+  ds5link::effects::Session effects;
+  std::mutex output_mutex,bluetooth_write_mutex;
+  vds::DsOutputState xbox_output;
+  std::optional<vds::DsState> xbox_last;
+  auto xbox_last_send=Clock::time_point{};
+  // Apply brightness alone; PS5 initialization also configures unrelated audio/power lanes.
+  if(!try_send_bt_output_report(*bluetooth,xbox_output.build_bt_state_report(ds5link::effects::xbox_led_setup()),logger,bluetooth_write_mutex,"Xbox LED brightness"))throw std::runtime_error("Cannot initialize Xbox physical controller output");
+  auto rumble=[&](unsigned motors,bool release=false){
+    auto base=ds5link::effects::xbox_state(motors,release);
+    std::lock_guard lock(output_mutex);
+    if(!release){
+      effects.rumble_owned|=xbox.feedback_received();
+      std::optional<int> battery;{std::lock_guard lock(g_telemetry.mutex);battery=g_telemetry.battery;}
+      ensure_manual_led_ready(*bluetooth,xbox_output,effects,logger,bluetooth_write_mutex);
+      auto output=ds5link::effects::runtime::render(base,effects,battery,false);
+      if(xbox_last && *xbox_last==output && Clock::now()-xbox_last_send<std::chrono::milliseconds(200))return;
+      if(try_send_bt_output_report(*bluetooth,xbox_output.build_bt_state_report(output),logger,bluetooth_write_mutex,"Xbox output")){xbox_last=output;xbox_last_send=Clock::now();}
+    }else try_send_bt_output_report(*bluetooth,xbox_output.build_bt_state_report(base),logger,bluetooth_write_mutex,"Xbox release");
+  };
+  rumble(0);
+  std::atomic_bool ended=false,input_stalled=false;std::atomic_uint64_t last_input_tick=GetTickCount64();
+  std::thread monitor([&]{
+    while(!ended && !stop && !g_stop_requested){
+      if(ds5link::recovery::overdue(GetTickCount64(),last_input_tick.load(),5000)){input_stalled=true;bluetooth->cancel();break;}
+      const auto next=xbox.motors();
+      try{rumble(next);}catch(...){}
+      std::this_thread::sleep_for(kAudioOutputBaseInterval);
+    }
+    try{rumble(0,true);Sleep(20);}catch(...){}
+    ds5link::effects::runtime::clear_status();
+    bluetooth->cancel();
+  });
+  std::exception_ptr failure;
+  try {
+    while(!stop && !g_stop_requested){
+      auto frame=bluetooth->read_frame();
+      if(frame.header.type!=VDS_FRAME_BT_INTERRUPT_PACKET)continue;
+      auto report=bt_input_to_usb_input(frame.payload);
+      if(!report)continue;
+      last_input_tick=GetTickCount64();
+      {
+        std::lock_guard lock(g_telemetry.mutex);
+        g_telemetry.last_input=Clock::now();g_telemetry.metrics.add(g_telemetry.last_input);
+        g_telemetry.bluetooth_idle.observe(*report,g_telemetry.last_input);
+        auto battery=ds5link::decode_battery_status((*report)[53]);
+        g_telemetry.battery=battery.percent;g_telemetry.charging=battery.charging;
+        g_telemetry.headphones=((*report)[54]&1)!=0;
+      }
+      ds5link::input::process(input_processor,*report);
+      xbox.update(*report);
+    }
+  }catch(...){failure=std::current_exception();}
+  ended=true;monitor.join();
+  if(input_stalled && !stop && !g_stop_requested)throw std::runtime_error("Bluetooth input stalled; reconnecting controller");
+  if(failure && !stop && !g_stop_requested)std::rethrow_exception(failure);
+}
