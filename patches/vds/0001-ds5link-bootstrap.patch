@@ -0,0 +1,11 @@
+#include "audio_reservation.hh"
+#include <deque>
+#include <stdexcept>
+#include <iostream>
+int main(){std::deque<int> queue{1,2};auto in_flight=ds5link::reserve_audio_front(queue);
+ // Producer resets the old stream while its reserved packet is in flight.
+ queue.clear();queue.push_back(100);queue.push_back(101);
+ // Completion (success or failure) owns in_flight, never pops producer's new head.
+ if(in_flight!=1 || queue.front()!=100 || queue.size()!=2)throw std::runtime_error("new stream consumed by old completion");
+ auto next=ds5link::reserve_audio_front(queue);if(next!=100 || queue.front()!=101)throw std::runtime_error("reservation order changed");
+ std::cout<<"Audio reservation survives reset during transport I/O\n";}
diff --git a/tests/audio_tests.cc b/tests/audio_tests.cc
new file mode 100644
index 0000000..b677c3a
--- /dev/null
+++ b/tests/audio_tests.cc
@@ -0,0 +1,45 @@
+// SPDX-License-Identifier: MIT
+#include "vds_protocol.hh"
+#include <algorithm>
+#include <iostream>
+#include <stdexcept>
+
+void check(bool value,const char* message){if(!value)throw std::runtime_error(message);}
+std::vector<std::uint8_t> pcm(unsigned channel,short value) {
+  std::vector<std::uint8_t> bytes(vds::kPcmWindowFrames*8,0);
+  for(size_t frame=0;frame<vds::kPcmWindowFrames;++frame) {
+    const auto sample=static_cast<unsigned short>(value);
+    bytes[frame*8+channel*2]=sample&255;
+    bytes[frame*8+channel*2+1]=sample>>8;
+  }
+  return bytes;
+}
+vds::AudioChunk extract(const std::vector<std::uint8_t>& bytes) {
+  vds::PcmAudioExtractor extractor;
+  auto chunks=extractor.push_usb_audio(bytes);
+  check(chunks.size()==1,"PCM window did not produce one chunk");return chunks.front();
+}
+int main() {
+  try {
+    const auto silence=extract(pcm(0,0));
+    check(!silence.has_signal && !silence.has_haptics_signal,"silence marked active");
+    for(unsigned channel=0;channel<4;++channel) {
+      const auto bytes=pcm(channel,10000);
+      const auto chunk=extract(bytes);
+      check(chunk.has_signal,"signal missing");
+      check(chunk.has_haptics_signal==(channel>=2),"speaker/haptics channel flag crossed");
+      const bool haptics=std::any_of(chunk.haptics.begin(),chunk.haptics.end(),[](auto s){return s!=0;});
+      check(haptics==(channel>=2),"speaker leaked into haptics or haptics missing");
+      if(channel>=2) check(chunk.speaker==silence.speaker,"haptics leaked into speaker encoder");
+      // USB reads can split a PCM frame at any byte boundary.
+      for(size_t split=1;split<8;++split) {
+        vds::PcmAudioExtractor fragmented;
+        auto first=fragmented.push_usb_audio(std::span(bytes).first(split));
+        check(first.empty(),"partial PCM frame emitted audio");
+        auto rest=fragmented.push_usb_audio(std::span(bytes).subspan(split));
+        check(rest.size()==1 && rest[0].haptics==chunk.haptics && rest[0].speaker==chunk.speaker,"fragmented PCM changed channel data");
+      }
+    }
+    std::cout<<"audio channel and fragmentation tests passed\n";return 0;
+  }catch(const std::exception& e){std::cerr<<e.what()<<'\n';return 1;}
+}
