+void check(bool ok,const char* why){if(!ok)throw std::runtime_error(why);}
+Report neutral(){Report r{};r[0]=1;r[1]=r[2]=r[3]=r[4]=128;r[33]=r[37]=128;return r;}
+Report touch(int x,int y,bool click=false,int id=1){auto r=neutral();r[33]=id;r[34]=x&255;r[35]=((x>>8)&15)|((y&15)<<4);r[36]=y>>4;r[10]=click?2:0;return r;}
+void test_bluetooth_idle_timer(){
+ using namespace std::chrono_literals;
+ const auto start=std::chrono::steady_clock::time_point{};
+ auto idle=neutral();
+ idle[8]=8;idle[1]=136;idle[5]=3;idle[16]=32;
+ ds5link::BluetoothIdleTimer timer;
+ check(!timer.expired(start+5min),"idle timer fired before receiving input");
+ for(int second=0;second<300;++second){
+  idle[7]=static_cast<std::uint8_t>(second);
+  idle[28]=static_cast<std::uint8_t>(second);
+  timer.observe(idle,start+std::chrono::seconds(second));
+ }
+ check(!timer.expired(start+299s),"idle timer fired early");
+ timer.observe(idle,start+5min);
+ check(timer.expired(start+5min),"neutral packets or sensor noise reset the timer");
+ check(!timer.expired(start+302s),"idle timer accepted stale input");
+ timer.observe(idle,start+10min);
+ check(!timer.expired(start+10min),"input gap did not reset the timer");
+
+ ds5link::BluetoothIdleTimer game;
+ for(int second=0;second<=900;++second){
+  const auto now=start+std::chrono::seconds(second);
+  game.observe(idle,now);
+  check(game.expired(now,now+5s)==(second==900),"foreground game has wrong idle limit");
+ }
+ ds5link::BluetoothIdleTimer left_game;
+ for(int second=0;second<=780;++second){
+  const auto now=start+std::chrono::seconds(second);
+  left_game.observe(idle,now);
+  check(left_game.expired(now,start+8min)==(second==780),"desktop countdown after game focus lost is wrong");
+ }
+
+ for(const auto [offset,value]:std::array<std::pair<int,int>,9>{{
+     {8,0x18},{8,4},{9,1},{10,4},{1,160},{5,16},{33,1},{37,2},{17,2}}}){
+  ds5link::BluetoothIdleTimer active;
+  for(int second=0;second<300;++second)active.observe(idle,start+std::chrono::seconds(second));
+  auto pressed=idle;
+  pressed[offset]=static_cast<std::uint8_t>(value);
+  active.observe(pressed,start+5min);
+  check(!active.expired(start+5min),"controller activity did not reset the timer");
+  for(int second=301;second<=600;++second)active.observe(idle,start+std::chrono::seconds(second));
+  check(active.expired(start+10min),"timeout did not restart from controller activity");
+ }
+}
+int main(){
+ test_bluetooth_idle_timer();
+ ds5link::InputProcessor p;ds5link::InputOptions off;
+ for(int x=0;x<256;x++)for(int y=0;y<256;y++){auto r=neutral();r[1]=x;r[2]=y;auto original=r;check(!p.process(r,off,0) && r==original,"disabled processing changed native report");}
+ auto r=neutral();r[1]=140;r[2]=120;r[3]=255;auto original=r;
+ ds5link::InputOptions zones{20,0,false,true};p.process(r,zones,0);check(r[1]==128 && r[2]==128 && r[3]==255,"independent stick deadzones failed");
+ int last=128;for(int x=128;x<256;x++){auto s=neutral();s[1]=x;p.process(s,zones,0);check(s[1]>=last,"deadzone response not monotonic");last=s[1];}check(last==255,"deadzone lost full stick range");
+ auto diagonal=neutral();diagonal[1]=diagonal[2]=255;p.process(diagonal,zones,0);check(diagonal[1]==255 && diagonal[2]==255,"corner range clipped");
+ ds5link::InputOptions enabled{0,0,true,true};
+ auto reset=[&]{p=ds5link::InputProcessor{};auto n=neutral();p.process(n,enabled,0);};
+ reset();r=touch(200,300);p.process(r,enabled,10);r=touch(200,300,true);check(p.process(r,enabled,20)==ds5link::TouchAction::LeftClick,"left click missing");check((r[10]&2)==0 && (r[33]&128)==0,"mapped click suppression damaged native contacts");
+ r=touch(200,300,true);check(!p.process(r,enabled,30),"held click repeated");r=neutral();check(!p.process(r,enabled,100),"click also emitted tap");
+ reset();r=touch(1700,300);p.process(r,enabled,10);r=touch(1700,300,true);check(p.process(r,enabled,20)==ds5link::TouchAction::RightClick,"right click missing");
+ reset();r=touch(200,300);p.process(r,enabled,10);r=neutral();check(p.process(r,enabled,100)==ds5link::TouchAction::Tap,"tap missing");
+ for(auto direction:{ds5link::TouchAction::SwipeLeft,ds5link::TouchAction::SwipeRight,ds5link::TouchAction::SwipeUp,ds5link::TouchAction::SwipeDown}){
+  reset();r=touch(900,500);p.process(r,enabled,10);
+  r=touch(direction==ds5link::TouchAction::SwipeLeft?300:direction==ds5link::TouchAction::SwipeRight?1500:900,direction==ds5link::TouchAction::SwipeUp?100:direction==ds5link::TouchAction::SwipeDown?900:500);p.process(r,enabled,100);r=neutral();check(p.process(r,enabled,180)==direction,"swipe direction failed");
