+ p=ds5link::InputProcessor{};r=touch(100,100,true);check(!p.process(r,enabled,0),"initial held click replayed");r=neutral();check(!p.process(r,enabled,100),"initial held contact replayed tap");
+ reset();auto native=enabled;native.consume_touchpad=false;r=neutral();p.process(r,native,0);r=touch(100,100,true);auto copy=r;check(p.process(r,native,20)==ds5link::TouchAction::LeftClick && r==copy,"native touch passthrough was modified");
+ // Partial bindings must preserve every byte except the assigned click bit.
+ auto selective=enabled;selective.touch_click_mask=1;
+ p=ds5link::InputProcessor{};r=neutral();p.process(r,selective,0);
+ r=touch(1700,300,true);r[8]=0xf8;r[9]=0xff;r[10]|=5;copy=r;
+ p.process(r,selective,10);check(r==copy,"Unbound right click or other controller buttons were suppressed");
+ r=neutral();p.process(r,selective,20);r=touch(100,300,true);copy=r;p.process(r,selective,30);copy[10]&=~2;
+ check(r==copy,"Assigned left click changed unrelated report bytes");
+ r=touch(1700,300,true);p.process(r,selective,40);check((r[10]&2)==0,"Mapped held click leaked after crossing sides");
+ r=neutral();p.process(r,selective,50);r=touch(1700,300,true);copy=r;p.process(r,selective,60);check(r==copy,"Native right click not restored after release");
+ selective.touch_click_mask=0;p=ds5link::InputProcessor{};r=neutral();p.process(r,selective,0);r=touch(100,300,true);copy=r;p.process(r,selective,10);check(r==copy,"Gesture-only mappings disabled native map click");
+ const auto path=std::filesystem::temp_directory_path()/("ds5link-input-test-"+ds5link::input::epoch+".json");
+ check(ds5link::input::preview()["ageMs"]==-1,"preview invented an input sample");
+ ds5link::input::configure(path.string());
+ auto settings=ds5link::input::json(enabled);ds5link::input::update(settings);
+ check(std::filesystem::exists(path),"input settings were not persisted");
+ bool rejected=false;auto invalid=settings;invalid["leftDeadzone"]=31;try{ds5link::input::update(invalid);}catch(...){rejected=true;}check(rejected && ds5link::input::current()==settings,"invalid options changed live settings");
+ invalid=settings;invalid["leftDeadzone"]=4294967296ULL;rejected=false;try{ds5link::input::parse(invalid);}catch(...){rejected=true;}check(rejected,"out-of-range JSON integer accepted");
+ ds5link::InputProcessor live;r=touch(100,100,true);auto originalTouch=r;ds5link::input::process(live,r);check(r==originalTouch,"touch consumed without UI heartbeat");
+ auto snapshot=ds5link::input::preview();check(snapshot["touches"][0]["x"]==100 && snapshot["click"]==true && snapshot["ageMs"]>=0,"preview lost raw touch input");
+ ds5link::input::preview();r=touch(100,100,true);originalTouch=r;ds5link::input::process(live,r);check(r==originalTouch,"read-only preview enabled touch consumption");
+ ds5link::input::read_events(0);r=neutral();ds5link::input::process(live,r);r=touch(100,100,true);ds5link::input::process(live,r);
+ auto batch=ds5link::input::read_events(0);check(batch["events"].size()==1,"touch event not queued");auto seq=batch["sequence"].get<std::uint64_t>();check(ds5link::input::read_events(seq)["events"].empty(),"acknowledged touch event repeated");
+ std::this_thread::sleep_for(std::chrono::milliseconds(550));check(ds5link::input::preview()["ageMs"]>=500,"stale preview not marked stale");ds5link::input::preview();r=touch(100,100,true);originalTouch=r;ds5link::input::process(live,r);check(r==originalTouch,"touch not restored after UI heartbeat expired");
+ auto previewZones=settings;previewZones["leftDeadzone"]=20;ds5link::input::update(previewZones);r=neutral();r[1]=140;ds5link::input::process(live,r);check(r[1]==128 && ds5link::input::preview()["leftX"]==140,"preview captured transformed stick instead of raw input");ds5link::input::update(settings);
+ ds5link::input::configure(path.string());check(ds5link::input::current()==settings,"saved input options did not reload");std::filesystem::remove(path);
+ std::cout<<"Input defaults, deadzones, clicks, gestures, contact changes and passthrough passed\n";
+}
