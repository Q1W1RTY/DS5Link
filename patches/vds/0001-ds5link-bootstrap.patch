diff --git a/src/platform/win32/usbip_deadline.hh b/src/platform/win32/usbip_deadline.hh
new file mode 100644
index 0000000..480b2de
--- /dev/null
+++ b/src/platform/win32/usbip_deadline.hh
@@ -0,0 +1,35 @@
+#pragma once
+#include <winsock2.h>
+#include <chrono>
+#include <cstddef>
+#include <atomic>
+#include <algorithm>
+namespace ds5link {
+inline thread_local std::chrono::steady_clock::time_point handshake_deadline{};
+inline thread_local const std::atomic_bool* handshake_stop=nullptr;
+inline bool recv_exact(SOCKET s, void *buffer, std::size_t size) {
+  auto *data = static_cast<char *>(buffer);
+  std::size_t remaining = size;
+  while (remaining > 0) {
+    if(handshake_stop && handshake_stop->load())return false;
+    if(handshake_deadline!=std::chrono::steady_clock::time_point{}){
+      const auto left=std::chrono::duration_cast<std::chrono::microseconds>(handshake_deadline-std::chrono::steady_clock::now()).count();
+      if(left<=0)return false;
+      fd_set readable;FD_ZERO(&readable);FD_SET(s,&readable);
+      const auto slice=std::min<long long>(left,20000);
+      timeval timeout{0,static_cast<long>(slice)};
+      const int ready=select(0,&readable,nullptr,nullptr,&timeout);
+      if(ready<0)return false;
+      if(ready==0)continue;
+    }
+    const int got = recv(s, data, static_cast<int>(remaining), 0);
+    if (got <= 0) {
+      return false;
+    }
+    data += got;
+    remaining -= static_cast<std::size_t>(got);
+  }
+  return true;
+}
+
+}
