+ {Pair p;char bytes[8]{};std::atomic_bool stopped=false;ds5link::handshake_stop=&stopped;std::jthread cancel([&]{std::this_thread::sleep_for(20ms);stopped=true;});ds5link::handshake_deadline=std::chrono::steady_clock::now()+5s;auto start=std::chrono::steady_clock::now();check(!ds5link::recv_exact(p.server,bytes,8),"cancelled reader succeeded");check(std::chrono::steady_clock::now()-start<2s,"cancelled reader stuck");ds5link::handshake_stop=nullptr;}
+ {Pair p;char expected[]="12345678",bytes[8]{};send(p.client,expected,8,0);ds5link::handshake_deadline=std::chrono::steady_clock::now()+1s;check(ds5link::recv_exact(p.server,bytes,8),"valid next client failed");}
+
+ {const std::string name="\\\\.\\pipe\\DS5Link.BlockedWrite."+std::to_string(GetCurrentProcessId());
+ HANDLE server=CreateNamedPipeA(name.c_str(),PIPE_ACCESS_OUTBOUND|FILE_FLAG_OVERLAPPED,PIPE_TYPE_BYTE|PIPE_WAIT,1,4096,4096,0,nullptr);
+ check(server!=INVALID_HANDLE_VALUE,"test pipe creation failed");
+ HANDLE client=CreateFileA(name.c_str(),GENERIC_READ,0,nullptr,OPEN_EXISTING,0,nullptr);check(client!=INVALID_HANDLE_VALUE,"test pipe client failed");
+ HANDLE event=CreateEventW(nullptr,TRUE,FALSE,nullptr),stop=CreateEventW(nullptr,TRUE,FALSE,nullptr);OVERLAPPED operation{};operation.hEvent=event;
