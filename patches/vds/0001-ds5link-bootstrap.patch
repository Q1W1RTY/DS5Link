diff --git a/tests/hardware_probe.cc b/tests/hardware_probe.cc
new file mode 100644
index 0000000..dbcc083
--- /dev/null
+++ b/tests/hardware_probe.cc
@@ -0,0 +1,165 @@
+// SPDX-License-Identifier: MIT
+// Local hardware diagnostics; does not modify the default Windows endpoints.
+#define NOMINMAX
+#include <windows.h>
+#include <mmdeviceapi.h>
+#include <audioclient.h>
+#include <functiondiscoverykeys_devpkey.h>
+#include <mmsystem.h>
+#include <ks.h>
+#include <ksmedia.h>
+#include <wrl/client.h>
+#include <cmath>
+#include <iostream>
+#include <string>
+#include <vector>
+#include <cstring>
+using Microsoft::WRL::ComPtr;
+
+void defaults() {
+  ComPtr<IMMDeviceEnumerator> enumerator;
+  auto hr = CoCreateInstance(__uuidof(MMDeviceEnumerator), nullptr, CLSCTX_ALL,
+                            IID_PPV_ARGS(&enumerator));
+  if (FAILED(hr)) throw std::runtime_error("CoreAudio enumerator failed");
+  for (int flow=0; flow<2; ++flow) for (int role=0; role<3; ++role) {
+    ComPtr<IMMDevice> device;
+    hr = enumerator->GetDefaultAudioEndpoint(static_cast<EDataFlow>(flow), static_cast<ERole>(role), &device);
+    std::wcout << L"default " << flow << L' ' << role << L' ';
+    if (SUCCEEDED(hr)) { LPWSTR id=nullptr; device->GetId(&id); if(id) {std::wcout << id; CoTaskMemFree(id);} }
+    else std::wcout << L"unavailable";
+    std::wcout << L'\n';
+  }
+}
+
+void capture_microphone(bool audio, unsigned seconds=4) {
+  ComPtr<IMMDeviceEnumerator> enumerator;
+  if(FAILED(CoCreateInstance(__uuidof(MMDeviceEnumerator),nullptr,CLSCTX_ALL,IID_PPV_ARGS(&enumerator))))
+    throw std::runtime_error("Cannot enumerate capture endpoints");
+  ComPtr<IMMDeviceCollection> collection;
+  if(FAILED(enumerator->EnumAudioEndpoints(eCapture,DEVICE_STATE_ACTIVE,&collection)))
+    throw std::runtime_error("Cannot list capture endpoints");
+  UINT count=0; collection->GetCount(&count);
+  unsigned selected=0;
+  for(UINT i=0;i<count;++i) {
+    ComPtr<IMMDevice> device; collection->Item(i,&device);
+    ComPtr<IPropertyStore> properties;
+    if(FAILED(device->OpenPropertyStore(STGM_READ,&properties))) continue;
+    PROPVARIANT name; PropVariantInit(&name);
+    properties->GetValue(PKEY_Device_FriendlyName,&name);
+    const bool match=name.vt==VT_LPWSTR && std::wstring(name.pwszVal).find(L"DualSense")!=std::wstring::npos;
+    PropVariantClear(&name);
+    if(!match) continue;
+    ++selected;
+    std::wcout << L"capture_endpoint found\n";
+    if(!audio) continue;
+    ComPtr<IAudioClient> client;
+    HRESULT hr=device->Activate(__uuidof(IAudioClient),CLSCTX_ALL,nullptr,reinterpret_cast<void**>(client.GetAddressOf()));
+    if(FAILED(hr)) throw std::runtime_error("Cannot activate capture client");
+    WAVEFORMATEX* raw_format=nullptr;
+    hr=client->GetMixFormat(&raw_format);
+    if(FAILED(hr)) throw std::runtime_error("Cannot obtain capture format");
+    const auto block_align=raw_format->nBlockAlign;
+    const auto rate=raw_format->nSamplesPerSec;
+    const auto sample_bits=raw_format->wBitsPerSample;
+    const bool floating=raw_format->wFormatTag==WAVE_FORMAT_IEEE_FLOAT ||
+      (raw_format->wFormatTag==WAVE_FORMAT_EXTENSIBLE && reinterpret_cast<WAVEFORMATEXTENSIBLE*>(raw_format)->SubFormat==KSDATAFORMAT_SUBTYPE_IEEE_FLOAT);
+    hr=client->Initialize(AUDCLNT_SHAREMODE_SHARED,0,10000000,0,raw_format,nullptr);
+    CoTaskMemFree(raw_format);
+    if(FAILED(hr)) throw std::runtime_error("Cannot initialize microphone: "+std::to_string(hr));
+    ComPtr<IAudioCaptureClient> capture;
+    if(FAILED(client->GetService(IID_PPV_ARGS(&capture)))) throw std::runtime_error("Cannot obtain capture service");
+    if(FAILED(client->Start())) throw std::runtime_error("Cannot start microphone");
+    std::uint64_t frames_total=0, nonzero_bytes=0, silent_frames=0;
+    const auto started=GetTickCount64();
+    const auto deadline=started+seconds*1000;
+    auto next_summary=started+1000;
+    std::uint64_t bin_nonzero=0,bin_frames=0;
+    double bin_peak=0,bin_square_sum=0;std::uint64_t bin_samples=0;
+    while(GetTickCount64()<deadline) {
+      UINT32 frames=0;
+      hr=capture->GetNextPacketSize(&frames);
+      if(FAILED(hr)) {client->Stop();throw std::runtime_error("Cannot query capture packet");}
+      if(!frames) {Sleep(5);continue;}
+      BYTE* data=nullptr; DWORD flags=0;
+      hr=capture->GetBuffer(&data,&frames,&flags,nullptr,nullptr);
+      if(FAILED(hr)) {client->Stop();throw std::runtime_error("Cannot read microphone");}
+      frames_total+=frames;
+      bin_frames+=frames;
+      if(flags&AUDCLNT_BUFFERFLAGS_SILENT) silent_frames+=frames;
+      else if(data) {
+        const auto bytes=static_cast<size_t>(frames)*block_align;
+        for(size_t j=0;j<bytes;++j) {nonzero_bytes+=data[j]!=0;bin_nonzero+=data[j]!=0;}
+        const auto sample_bytes=sample_bits/8;
+        if(!sample_bytes) throw std::runtime_error("Invalid microphone sample size");
+        for(size_t j=0;j+sample_bytes<=bytes;j+=sample_bytes) {
+          double sample=0;
+          if(floating && sample_bits==32) {float value;std::memcpy(&value,data+j,4);sample=value;}
+          else if(!floating && sample_bits==16) {short value;std::memcpy(&value,data+j,2);sample=value/32768.0;}
+          bin_peak=std::max(bin_peak,std::abs(sample));bin_square_sum+=sample*sample;++bin_samples;
+        }
+      }
+      capture->ReleaseBuffer(frames);
+      if(GetTickCount64()>=next_summary) {
+        std::wcout<<L"mic_bin elapsed_ms="<<GetTickCount64()-started<<L" frames="<<bin_frames<<L" nonzero_bytes="<<bin_nonzero<<L" peak="<<bin_peak<<L" rms="<<std::sqrt(bin_square_sum/std::max<std::uint64_t>(1,bin_samples))<<L'\n';
+        bin_nonzero=bin_frames=bin_samples=0;bin_peak=bin_square_sum=0;next_summary+=1000;
+      }
+    }
+    client->Stop();
+    std::wcout << L"microphone frames=" << frames_total << L" sample_rate=" << rate << L" nonzero_bytes=" << nonzero_bytes << L" silent_frames=" << silent_frames << L'\n';
+    if(!frames_total) throw std::runtime_error("No microphone frames received");
+  }
+  if(audio && selected!=1) throw std::runtime_error("Expected exactly one DualSense capture endpoint, found "+std::to_string(selected));
+}
+
+int main(int argc, char** argv) {
+  CoInitializeEx(nullptr, COINIT_MULTITHREADED);
+  try {
+    defaults();
+    const bool audio = argc==2 && std::string(argv[1])=="--audio-test";
+    const bool mic_only = argc==2 && std::string(argv[1])=="--mic-test";
+    const bool stereo = argc==2 && std::string(argv[1])=="--stereo-test";
+    if(argc>1 && !audio && !mic_only && !stereo) throw std::runtime_error("Unknown argument");
+    unsigned played=0;
+    for (UINT i=0; i<waveOutGetNumDevs(); ++i) {
+      WAVEOUTCAPSW caps{}; waveOutGetDevCapsW(i,&caps,sizeof(caps));
+      if (std::wstring(caps.szPname).find(L"DualSense")==std::wstring::npos) continue;
+      std::wcout << L"render " << i << L" channels=" << caps.wChannels << L'\n';
+      if (!audio && !stereo) continue;
+      WAVEFORMATEXTENSIBLE format{};
+      format.Format={WAVE_FORMAT_EXTENSIBLE,4,48000,384000,8,16,22};
+      format.Samples.wValidBitsPerSample=16;
+      format.dwChannelMask=SPEAKER_FRONT_LEFT|SPEAKER_FRONT_RIGHT|SPEAKER_BACK_LEFT|SPEAKER_BACK_RIGHT;
+      format.SubFormat=KSDATAFORMAT_SUBTYPE_PCM;
+      HWAVEOUT output{};
+      auto result=waveOutOpen(&output,i,&format.Format,0,0,CALLBACK_NULL);
+      if (result!=MMSYSERR_NOERROR) throw std::runtime_error("Cannot open 4-channel DualSense audio: "+std::to_string(result));
+      // 1 s speaker only, 1 s silence, 1 s haptics only, 1 s silence.
+      std::vector<short> pcm(48000*4*4);
+      for (size_t frame=0; frame<48000*4; ++frame) {
+        const auto second=frame/48000;
+        const double t=static_cast<double>(frame%48000)/48000;
+        const double fade=std::min(1.0,std::min(t*100,(1.0-t)*100));
+        if(stereo) {
+          if(second==0) pcm[frame*4]=static_cast<short>(1500*fade*std::sin(2*3.141592653589793*440*t));
+          if(second==2) pcm[frame*4+1]=static_cast<short>(1500*fade*std::sin(2*3.141592653589793*880*t));
+        } else {
+          if(second==0) pcm[frame*4]=pcm[frame*4+1]=static_cast<short>(1500*fade*std::sin(2*3.141592653589793*660*t));
+          if(second==2) pcm[frame*4+2]=pcm[frame*4+3]=static_cast<short>(3000*fade*std::sin(2*3.141592653589793*80*t));
+        }
+      }
+      WAVEHDR header{}; header.lpData=reinterpret_cast<char*>(pcm.data()); header.dwBufferLength=static_cast<DWORD>(pcm.size()*2);
+      waveOutPrepareHeader(output,&header,sizeof(header));
+      result=waveOutWrite(output,&header,sizeof(header));
+      const auto deadline=GetTickCount64()+8000;
+      while(result==0 && !(header.dwFlags&WHDR_DONE) && GetTickCount64()<deadline) Sleep(10);
+      const bool complete=(header.dwFlags&WHDR_DONE)!=0;
+      waveOutReset(output); waveOutUnprepareHeader(output,&header,sizeof(header)); waveOutClose(output);
+      if(!complete || result) throw std::runtime_error("Audio playback did not complete");
+      std::wcout << L"4-channel playback completed\n";
+      ++played;
+    }
+    if((audio || stereo) && played!=1)throw std::runtime_error("Expected exactly one DualSense playback endpoint");
+    capture_microphone(audio || mic_only,mic_only?24:4); // Samples are discarded, never saved.
+    CoUninitialize(); return 0;
+  } catch(const std::exception& e) {std::cerr << e.what() << '\n'; CoUninitialize(); return 1;}
+}
diff --git a/tests/hid_probe.cc b/tests/hid_probe.cc
new file mode 100644
index 0000000..20faac6
--- /dev/null
+++ b/tests/hid_probe.cc
@@ -0,0 +1,122 @@
+// SPDX-License-Identifier: MIT
+#define NOMINMAX
+#include <windows.h>
+#include <hidsdi.h>
+#include <setupapi.h>
+#include <array>
+#include <cstring>
+#include <iostream>
+#include <set>
+#include <stdexcept>
+#include <string>
+#include <vector>
+#include <algorithm>
+#include <nlohmann/json.hpp>
+#include "vds/ds5_protocol.h"
+
+struct Handle {
+  HANDLE value=INVALID_HANDLE_VALUE;
+  ~Handle(){if(value!=INVALID_HANDLE_VALUE && value) CloseHandle(value);}
+};
+bool transfer(HANDLE device, void* data, DWORD size, bool write, DWORD& count, DWORD timeout) {
+  Handle event{CreateEventW(nullptr,TRUE,FALSE,nullptr)};
+  OVERLAPPED operation{}; operation.hEvent=event.value;
+  BOOL ok=write?WriteFile(device,data,size,&count,&operation):ReadFile(device,data,size,&count,&operation);
+  if(!ok && GetLastError()!=ERROR_IO_PENDING) return false;
+  if(!ok && WaitForSingleObject(event.value,timeout)!=WAIT_OBJECT_0) {
+    CancelIoEx(device,&operation); GetOverlappedResult(device,&operation,&count,TRUE); return false;
+  }
+  return GetOverlappedResult(device,&operation,&count,TRUE)!=FALSE;
+}
+void send(HANDLE device, const vds_set_state_data& state) {
+  std::array<unsigned char,48> report{}; report[0]=2;
+  std::memcpy(report.data()+1,&state,sizeof(state)); DWORD written=0;
+  if(!transfer(device,report.data(),report.size(),true,written,2000) || written!=report.size())
+    throw std::runtime_error("Virtual HID output failed");
+}
+int main(int argc,char** argv) {
+  bool input_only=false,physical=false;unsigned seconds=10;
+  for(int i=1;i<argc;++i){std::string arg(argv[i]);if(arg=="--input-only")input_only=true;else if(arg=="--physical-usb"){physical=true;input_only=true;}else if(arg.rfind("--seconds=",0)==0)seconds=std::clamp(std::stoul(arg.substr(10)),1ul,120ul);else{std::cerr<<"Unknown argument\n";return 2;}}
+  Handle device;
+  vds_set_state_data reset{};
+  reset.allow_right_trigger_ffb=reset.allow_left_trigger_ffb=reset.allow_led_color=reset.allow_player_indicators=1;
+  reset.right_trigger_ffb[0]=reset.left_trigger_ffb[0]=5;
+  try {
+    GUID guid; HidD_GetHidGuid(&guid);
+    auto info=SetupDiGetClassDevsW(&guid,nullptr,nullptr,DIGCF_PRESENT|DIGCF_DEVICEINTERFACE);
+    if(info==INVALID_HANDLE_VALUE) throw std::runtime_error("HID enumeration failed");
+    for(DWORD i=0;;++i) {
+      SP_DEVICE_INTERFACE_DATA entry{sizeof(entry)};
+      if(!SetupDiEnumDeviceInterfaces(info,nullptr,&guid,i,&entry)) break;
+      DWORD size=0; SetupDiGetDeviceInterfaceDetailW(info,&entry,nullptr,0,&size,nullptr);
+      std::vector<unsigned char> storage(size);
+      if(size<sizeof(SP_DEVICE_INTERFACE_DETAIL_DATA_W)) continue;
+      auto detail=reinterpret_cast<SP_DEVICE_INTERFACE_DETAIL_DATA_W*>(storage.data()); detail->cbSize=sizeof(*detail);
+      if(!SetupDiGetDeviceInterfaceDetailW(info,&entry,detail,size,nullptr,nullptr)) continue;
+      HANDLE candidate=CreateFileW(detail->DevicePath,GENERIC_READ|GENERIC_WRITE,FILE_SHARE_READ|FILE_SHARE_WRITE,nullptr,OPEN_EXISTING,FILE_FLAG_OVERLAPPED,nullptr);
+      if(candidate==INVALID_HANDLE_VALUE) continue;
+      HIDD_ATTRIBUTES attributes{sizeof(attributes)}; wchar_t serial[128]{};
+      std::wstring path(detail->DevicePath);std::transform(path.begin(),path.end(),path.begin(),towlower);
+      const bool identity=HidD_GetSerialNumberString(candidate,serial,sizeof(serial)) && std::wstring(serial)==L"DS5Link-DualSense-Port-0";
+      const bool match=HidD_GetAttributes(candidate,&attributes) && attributes.VendorID==0x054c && attributes.ProductID==0x0ce6
+          && (physical?(!identity && path.find(L"vid_054c&pid_0ce6")!=std::wstring::npos):identity);
+      if(match) {device.value=candidate;break;}
+      CloseHandle(candidate);
+    }
+    SetupDiDestroyDeviceInfoList(info);
+    if(device.value==INVALID_HANDLE_VALUE) throw std::runtime_error("Our virtual DualSense was not found");
+    nlohmann::json firmware=nullptr;
+    std::array<unsigned char,64> feature{};feature[0]=0x20;
+    if(HidD_GetFeature(device.value,feature.data(),feature.size())) {
+      const auto le32=[&](unsigned offset){return static_cast<std::uint32_t>(feature[offset])|(static_cast<std::uint32_t>(feature[offset+1])<<8)|(static_cast<std::uint32_t>(feature[offset+2])<<16)|(static_cast<std::uint32_t>(feature[offset+3])<<24);};
+      firmware={{"hardwareVersion",le32(24)},{"firmwareVersion",le32(28)},{"updateVersion",static_cast<unsigned>(feature[44]|(feature[45]<<8))}};
+    }
+    if(!input_only)for(int color=0;color<3;++color) {
+      auto state=reset;
+      state.led_red=color==0?60:0;state.led_green=color==1?60:0;state.led_blue=color==2?60:0;
+      send(device.value,state);Sleep(800);
+    }
+    if(!input_only)for(int side=0;side<2;++side) {
+      auto state=reset;state.led_blue=40;
+      auto trigger=side==0?state.right_trigger_ffb:state.left_trigger_ffb;
+      trigger[0]=1;trigger[1]=80;trigger[2]=60; // Brief, moderate continuous resistance.
+      send(device.value,state);Sleep(3500);
+    }
+    if(!input_only)send(device.value,reset);
+    std::uint64_t reports=0,invalid=0;
+    std::set<std::array<unsigned char,6>> axes;
+    std::set<std::array<unsigned char,3>> buttons;
+    std::array<int,6> axis_min,axis_max;axis_min.fill(255);axis_max.fill(0);
+    std::array<int,3> gyro_min,gyro_max,accel_min,accel_max;gyro_min.fill(32767);accel_min.fill(32767);gyro_max.fill(-32768);accel_max.fill(-32768);
+    std::array<bool,8> dpad{};unsigned seen=0,max_contacts=0;std::uint64_t touch_samples=0;int touch_x_min=4095,touch_x_max=0,touch_y_min=4095,touch_y_max=0;
+    std::array<unsigned char,64> last{};
+    const auto deadline=GetTickCount64()+seconds*1000;
+    while(GetTickCount64()<deadline) {
+      std::array<unsigned char,64> input{};DWORD count=0;
+      if(!transfer(device.value,input.data(),input.size(),false,count,1000)) continue;
+      if(count!=64 || input[0]!=1) {++invalid;continue;}
+      ++reports;
+      last=input;
+      for(unsigned axis=0;axis<6;++axis){axis_min[axis]=std::min(axis_min[axis],static_cast<int>(input[1+axis]));axis_max[axis]=std::max(axis_max[axis],static_cast<int>(input[1+axis]));}
+      seen|=(input[8]>>4)|(input[9]<<4)|((input[10]&7)<<12);
+      if((input[8]&15)<8)dpad[input[8]&15]=true;
+      const auto s16=[&](unsigned offset){return static_cast<int>(static_cast<std::int16_t>(input[offset]|(input[offset+1]<<8)));};
+      for(unsigned axis=0;axis<3;++axis){auto gyro=s16(16+axis*2),accel=s16(22+axis*2);gyro_min[axis]=std::min(gyro_min[axis],gyro);gyro_max[axis]=std::max(gyro_max[axis],gyro);accel_min[axis]=std::min(accel_min[axis],accel);accel_max[axis]=std::max(accel_max[axis],accel);}
+      unsigned contacts=0;
