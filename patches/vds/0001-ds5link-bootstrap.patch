+ try{hidden=vds::win::hidhide::hide_device(found->instance,logger);}
+ catch(const std::runtime_error& error){
+  if(!ds5link::usb::safe_visibility_fallback(error.what()))throw;
+  physical_visible=true;logger.log(vds::LogScope::Daemon,vds::LogLevel::Warn,"USB Xbox: physical controller remains visible; unrelated HidHide settings preserved");
+ }
+ UsbGamepad usb(path);ds5link::XboxTarget xbox;ds5link::InputProcessor input;
+ ds5link::effects::Session effects;vds::DsOutputState game;std::optional<vds::DsState> last;
+ g_telemetry.clear();{std::lock_guard lock(g_telemetry.mutex);g_telemetry.physical_visible=physical_visible;}ds5link::effects::runtime::clear_status();
+ auto next_output=Clock::now();auto last_usb_input=next_output;auto last_usb_output=Clock::time_point{};
+ try{
+  while(!stop && !g_stop_requested){
+   std::array<std::uint8_t,64> report{};auto size=usb.read(report);
+   if(size==64 && report[0]==1){
+    last_usb_input=Clock::now();
+    ds5link::input::process(input,report);xbox.update(report);
+    std::lock_guard lock(g_telemetry.mutex);g_telemetry.last_input=Clock::now();g_telemetry.metrics.add(g_telemetry.last_input);
+    auto battery=ds5link::decode_battery_status(report[53]);g_telemetry.battery=battery.percent;g_telemetry.charging=battery.charging;g_telemetry.headphones=(report[54]&1)!=0;
+   }
+   if(Clock::now()-last_usb_input>std::chrono::seconds(5))throw std::runtime_error("USB input stalled; reconnecting controller");
+   if(Clock::now()<next_output)continue;next_output=Clock::now()+std::chrono::milliseconds(25);
+   effects.rumble_owned|=xbox.feedback_received();
+   auto base=ds5link::effects::xbox_state(xbox.motors());
+   if(ds5link::effects::runtime::needs_led_init(effects)){vds::DsState reset{};reset[38]=2;reset[offsetof(vds_set_state_data,light_fade_animation)]=2;usb.write(reset);effects.led_init_ms=std::chrono::duration_cast<std::chrono::milliseconds>(Clock::now().time_since_epoch()).count()+50;}
+   std::optional<int> battery;{std::lock_guard lock(g_telemetry.mutex);battery=g_telemetry.battery;}
+   auto output=ds5link::effects::runtime::render(base,effects,battery,false);
+   // USB audio haptics needs the physical audio endpoint, never a BT 0x36 packet.
+   output[0]=(output[0]&~3)|3;output[2]=base[2];output[3]=base[3];
+   if(!last || *last!=output || Clock::now()-last_usb_output>=std::chrono::milliseconds(200)){usb.write(output);last=output;last_usb_output=Clock::now();}
+  }
+ }catch(...){try{vds::DsState release{};release[0]=15;release[offsetof(vds_set_state_data,left_trigger_ffb)]=5;release[offsetof(vds_set_state_data,right_trigger_ffb)]=5;usb.write(release);}catch(...){}ds5link::effects::runtime::clear_status();throw;}
+ try{vds::DsState release{};release[0]=15;release[offsetof(vds_set_state_data,left_trigger_ffb)]=5;release[offsetof(vds_set_state_data,right_trigger_ffb)]=5;usb.write(release);}catch(...){}
+ ds5link::effects::runtime::clear_status();
+}
