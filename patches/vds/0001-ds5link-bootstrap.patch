@@ -0,0 +1,85 @@
+// SPDX-License-Identifier: MIT
+#define NOMINMAX
+#include <windows.h>
+#include <filesystem>
+#include <fstream>
+#include <iostream>
+#include <stdexcept>
+#include <thread>
+#include "platform/win32/vds_hidhide.hh"
+#include "vds_log.hh"
+#include <nlohmann/json.hpp>
+void check(bool value,const char* message){if(!value)throw std::runtime_error(message);}
+std::string read(const std::filesystem::path& path){std::ifstream s(path);return {std::istreambuf_iterator<char>(s),{}};}
+int main(int argc,char** argv) {
+  const auto temp=std::filesystem::temp_directory_path()/("ds5link-hidhide-"+std::to_string(GetCurrentProcessId()));
+  std::filesystem::create_directories(temp);
+  const auto state=temp/"state.txt";
+  const auto mock=std::filesystem::absolute(argv[0]).parent_path()/"ds5link_mock_hidhide.exe";
+  if(!std::filesystem::exists(mock)){std::cerr<<"mock backend missing\n";return 1;}
+  SetEnvironmentVariableW(L"VDS_HIDHIDE_CLI",mock.c_str());
+  SetEnvironmentVariableW(L"DS5LINK_MOCK_HIDHIDE_STATE",state.c_str());
+  try {
+    vds::Logger logger((temp/"log.txt").string());
+    vds::win::hidhide::configure_recovery((temp/"recovery.json").string());
+    const auto write=[&](std::string text){std::ofstream s(state);s<<text;};
+    write("--cloak-off\n--inv-off\n--dev-hide \"HID\\TARGET\"\n");
+    {vds::win::hidhide::DeviceGuard guard("HID\\TARGET",logger);check(read(state).find("--cloak-on")!=std::string::npos,"cloak not enabled");}
+    check(read(state).find("--cloak-off")!=std::string::npos,"initial cloak state not restored");
+    check(read(state).find("--dev-hide \"HID\\TARGET\"")!=std::string::npos,"pre-existing entry removed");
+    write("--cloak-off\n--inv-off\n");
+    {vds::win::hidhide::DeviceGuard guard("HID\\TARGET",logger);}
+    check(read(state).find("--dev-hide")==std::string::npos,"own device entry left behind");
+    write("--cloak-off\n--inv-off\n--dev-hide \"HID\\OTHER\"\n");
+    const auto before=read(state);bool rejected=false;
+    try{vds::win::hidhide::DeviceGuard guard("HID\\TARGET",logger);}catch(const std::runtime_error&){rejected=true;}
+    check(rejected && read(state)==before,"unrelated devices affected by global cloak");
+    write("--cloak-off\n--inv-on\n");rejected=false;
+    try{vds::win::hidhide::DeviceGuard guard("HID\\TARGET",logger);}catch(const std::runtime_error&){rejected=true;}
+    check(rejected && read(state)=="--cloak-off\n--inv-on\n","inverse mode was changed");
+    for(const auto variable:{L"DS5LINK_MOCK_HIDHIDE_ACCESS_OUTPUT",L"DS5LINK_MOCK_HIDHIDE_ACCESS_EXIT"}){
+      SetEnvironmentVariableW(variable,L"1");bool denied=false;
+      try{vds::win::hidhide::normalize_inverse_mode();}catch(const std::runtime_error& error){denied=std::string(error.what()).find("HIDHIDE_ACCESS_DENIED")!=std::string::npos;}
+      SetEnvironmentVariableW(variable,nullptr);
+      check(denied && read(state)=="--cloak-off\n--inv-on\n","access failure was mistaken for inverse mode or changed configuration");
+    }
+    // Explicit repair changes only inverse mode and preserves other applications/devices.
+    write("--cloak-on\n--inv-on\n--dev-hide \"HID\\OTHER\"\n--app-reg \"C:\\OtherApp.exe\"\n");
+    vds::win::hidhide::normalize_inverse_mode();
+    check(read(state).find("--inv-off")!=std::string::npos && read(state).find("--inv-on")==std::string::npos,"inverse repair failed");
+    check(read(state).find("--cloak-on")!=std::string::npos && read(state).find("HID\\OTHER")!=std::string::npos && read(state).find("C:\\OtherApp.exe")!=std::string::npos,"repair changed unrelated configuration");
+    const auto repaired=read(state);vds::win::hidhide::normalize_inverse_mode();
+    check(read(state)==repaired,"repair is not idempotent");
+    write("--cloak-off\n--inv-on\n");
+    {std::ofstream journal(temp/"recovery.json");journal<<"{}";}
+    rejected=false;try{vds::win::hidhide::normalize_inverse_mode();}catch(const std::runtime_error&){rejected=true;}
+    check(rejected && read(state)=="--cloak-off\n--inv-on\n","repair bypassed pending recovery");
+    std::filesystem::remove(temp/"recovery.json");
+    write("--cloak-off\n--inv-on\n");SetEnvironmentVariableW(L"DS5LINK_MOCK_IGNORE_INV_OFF",L"1");
+    rejected=false;try{vds::win::hidhide::normalize_inverse_mode();}catch(const std::runtime_error&){rejected=true;}
+    SetEnvironmentVariableW(L"DS5LINK_MOCK_IGNORE_INV_OFF",nullptr);
+    check(rejected && read(state).find("--inv-on")!=std::string::npos,"repair skipped verification after ignored change");
+    write("--cloak-off\n");rejected=false;
+    try{vds::win::hidhide::normalize_inverse_mode();}catch(const std::runtime_error&){rejected=true;}
+    check(rejected && read(state)=="--cloak-off\n","unknown inverse state was changed");
+    write("--cloak-off\n--inv-off\n");
+    {vds::win::hidhide::DeviceGuard guard("HID\\TARGET",logger);
+      const auto active=read(state);rejected=false;
+      std::thread repair([&]{try{vds::win::hidhide::normalize_inverse_mode();}catch(const std::runtime_error&){rejected=true;}});repair.join();
+      check(rejected && read(state)==active,"repair bypassed active lease");
+    }
+
+    write("--cloak-on\n--inv-off\n--dev-hide \"HID\\OTHER\"\n");
+    {vds::win::hidhide::DeviceGuard guard("HID\\TARGET",logger);}
+    check(read(state).find("--cloak-on")!=std::string::npos && read(state).find("HID\\OTHER")!=std::string::npos,"existing active configuration changed");
+    // Simulate an interrupted lease: durable intent exists, destructor did not run.
+    const auto executable=std::filesystem::absolute(argv[0]).string();
+    write("--cloak-on\n--inv-off\n--dev-hide \"HID\\TARGET\"\n--app-reg \""+executable+"\"\n");
+    {std::ofstream journal(temp/"recovery.json");journal<<nlohmann::json{{"schema",1},{"device","HID\\TARGET"},{"daemon",executable},{"hideAdded",true},{"cloakEnabled",true},{"appAdded",true}};}
+    vds::win::hidhide::recover_changes();
+    check(read(state).find("--cloak-off")!=std::string::npos && read(state).find("--dev-hide")==std::string::npos && read(state).find("--app-reg")==std::string::npos,"crash recovery did not revert owned changes");
+    check(!std::filesystem::exists(temp/"recovery.json"),"completed journal retained");
+    std::cout<<"HidHide ownership and cloak restoration tests passed\n";
+    return 0;
+  }catch(const std::exception& e){std::cerr<<e.what()<<'\n';return 1;}
+}
