+// SPDX-License-Identifier: MIT
+#pragma once
+#include <cstdint>
+#include <span>
+#include <stdexcept>
+#include <string>
+#include <vector>
+
+namespace vds::win::usbip {
+inline std::vector<std::uint8_t> device_descriptor_with_serial(std::span<const std::uint8_t> source) {
+  if (source.size()!=18 || source[0]!=18 || source[1]!=1)
+    throw std::invalid_argument("Invalid USB device descriptor");
+  std::vector<std::uint8_t> result(source.begin(),source.end());
+  result[16]=3; // Dedicated string descriptor; no physical MAC/serial exposed.
+  return result;
+}
+// SDL and Steam read feature 0x09 instead of the USB string serial.
+// Never expose the backing Bluetooth address as the virtual USB identity.
+inline std::vector<std::uint8_t> virtual_pairing_identity(std::span<const std::uint8_t> source,unsigned port) {
+  std::vector<std::uint8_t> result(source.begin(),source.end());
+  if(result.empty() || result[0]!=0x09)return result;
+  if(result.size()<7 || port>65534)throw std::invalid_argument("Invalid virtual pairing identity");
+  const unsigned id=port+1;
+  // Pairing report carries the device address in little endian order.
+  const std::uint8_t address[]{static_cast<std::uint8_t>(id),static_cast<std::uint8_t>(id>>8),0x35,0x53,0x44,0x02};
+  for(unsigned i=0;i<6;++i)result[i+1]=address[i];
+  return result;
+}
+inline std::string stable_virtual_serial(unsigned port) {
+  return "DS5Link-DualSense-Port-"+std::to_string(port);
+}
+}
