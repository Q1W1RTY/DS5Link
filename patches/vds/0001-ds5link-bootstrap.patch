+ CloseHandle(client);CloseHandle(server);CloseHandle(event);CloseHandle(stop);}
+ check(ds5link::reply_budget_available(255,8*1024*1024-1,1,2s),"valid reply budget rejected");
+ check(!ds5link::reply_budget_available(256,0,1,0s),"request budget not bounded");
