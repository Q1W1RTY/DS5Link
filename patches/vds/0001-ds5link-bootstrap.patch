+    for (const auto* path : {"usbip://127.0.0.1:3240/1-0", "usbip://127.0.0.1:3240/1-9999999999999999",
+                            "usbip://127.0.0.1:3240/1-1junk", "usbip://127.0.0.1:3240/1-",
+                            "usbip://192.0.2.1:3240/1-1", "vds-1", "vds"}) {
+      check(!vds::port_index_from_path(path), "invalid endpoint accepted");
+    }
+    const std::vector<std::string> endpoints{"usbip://127.0.0.1:3240/1-1"};
+    vds::ConfigDb db;
+    db.controllers.push_back({"00:11:22:33:44:55", vds::ControllerProfile::Ds5, {0}});
