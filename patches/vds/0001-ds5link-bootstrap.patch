+// USB Xbox uses the physical 0x01 input and 0x02 output reports directly.
+// No virtual PS5 or USB audio device is created on this path.
+void run_usb_xbox_session(const std::string& path,vds::Logger& logger,std::atomic_bool& stop){
+ auto devices=usb_dualsense_devices();auto found=std::find_if(devices.begin(),devices.end(),[&](const auto& d){return d.path==path;});
+ if(found==devices.end())throw std::runtime_error("USB DualSense disconnected");
