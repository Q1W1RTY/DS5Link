+void check(bool value){if(!value)throw std::runtime_error("Recovery policy assertion failed");}
+int main(int argc,char** argv){
+ using namespace ds5link::recovery;
+ if(argc==3){std::string mode=argv[1];std::atomic_uint64_t busy{mode=="control"?GetTickCount64():0},queued{mode=="queue"?GetTickCount64():0};Watchdog watchdog(argv[2],busy,500,&queued);for(;;){if(busy || queued)watchdog.beat("healthy supervisor");Sleep(50);}}
+ vds::ConfigDb config;config.controllers.push_back({"7c:66:ef:14:3a:14",vds::ControllerProfile::Ds5,{0}});
+ std::vector<vds::VdsdWorkerFailureBackoff> retries;auto now=std::chrono::steady_clock::now();
+ vds::record_vdsd_worker_failure(retries,"00:00:00:00:00:01",now-std::chrono::seconds(1));
+ vds::record_vdsd_worker_failure(retries,"7c:66:ef:14:3a:14",now+std::chrono::seconds(1));
+ vds::prune_vdsd_worker_retries(retries,config);check(retries.size()==1 && retries.front().address=="7c:66:ef:14:3a:14");
+ check(!vds::consume_vdsd_worker_retry(retries,"7c:66:ef:14:3a:14",now));check(vds::consume_vdsd_worker_retry(retries,"7c:66:ef:14:3a:14",now+std::chrono::seconds(2)) && retries.empty());
+ config.controllers.clear();vds::record_vdsd_worker_failure(retries,"00:00:00:00:00:01",now);vds::prune_vdsd_worker_retries(retries,config);check(retries.empty());
+ check(!overdue(999,1000,500));check(!overdue(1499,1000,500));check(overdue(1500,1000,500));
+ check(next_attempt(100,200,2)==1);check(next_attempt(300001,0,2)==1);check(next_attempt(1000,500,2)==3);
+ char temp[MAX_PATH]{},exe[MAX_PATH]{};GetTempPathA(MAX_PATH,temp);GetModuleFileNameA(nullptr,exe,MAX_PATH);
+ auto db=std::string(temp)+"ds5link-recovery-"+std::to_string(GetCurrentProcessId());
+ for(int attempt=1;attempt<=3;attempt++){
+  std::string line="\""+std::string(exe)+"\" "+(attempt==2?"control":attempt==3?"queue":"supervisor")+" \""+db+"\"";
+  STARTUPINFOA startup{sizeof(startup)};PROCESS_INFORMATION child{};check(CreateProcessA(nullptr,line.data(),nullptr,nullptr,FALSE,CREATE_NO_WINDOW,nullptr,nullptr,&startup,&child));
+  check(WaitForSingleObject(child.hProcess,5000)==WAIT_OBJECT_0);DWORD code=0;GetExitCodeProcess(child.hProcess,&code);CloseHandle(child.hProcess);CloseHandle(child.hThread);check(code==ERROR_TIMEOUT);
+  std::ifstream file(db+".recovery-status.json");nlohmann::json result;file>>result;check(result["attempt"]==attempt);check(result["paused"]==(attempt==3));if(attempt==2)check(result["phase"]=="control pipe");if(attempt==3)check(result["phase"]=="control queue starved");
+ }
+ check(std::filesystem::exists(db+".paused"));std::filesystem::remove(db+".paused");std::filesystem::remove(db+".recovery-status.json");
+ std::atomic_uint64_t busy{0};{Watchdog healthy(db,busy,500);for(int i=0;i<20;i++){healthy.beat("idle");Sleep(50);}}
+ check(!std::filesystem::exists(db+".recovery-status.json"));
+ std::cout<<"Supervisor/control pipe stalls recovered; healthy idle preserved; repeated restarts bounded\n";
+}
