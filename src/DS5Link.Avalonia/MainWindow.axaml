<?xml version='1.0' encoding='utf-8'?>
<Window xmlns="https://github.com/avaloniaui" xmlns:local="clr-namespace:DS5Link" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="DS5Link.MainWindow" Title="DS5Link" Icon="avares://DS5Link/Assets/DS5Link.ico" Width="388" MinWidth="388" MaxWidth="388" SizeToContent="Height" WindowStartupLocation="CenterScreen" Background="Transparent" FontFamily="{DynamicResource AppFontFamily}" UseLayoutRounding="True" FontFeatures="tnum" FontSize="13" Foreground="#F0F1F3" WindowDecorations="None" TransparencyLevelHint="Transparent" CanResize="False">
  <Window.Resources>
    <FontFamily x:Key="AppFontFamily">avares://DS5Link/Assets/Fonts#Geologica</FontFamily>
    <SolidColorBrush x:Key="ShellFrameBrush" Color="#EE18181B" />
    <SolidColorBrush x:Key="ShellBorderBrush" Color="#26FFFFFF" />
    <SolidColorBrush x:Key="ShellCardBrush" Color="#0EFFFFFF" />
    <SolidColorBrush x:Key="ShellCardBorderBrush" Color="#12FFFFFF" />
    <ControlTheme x:Key="SharedWindowFrame" TargetType="Border">
      <Setter Property="CornerRadius" Value="28" />
      <Setter Property="BorderThickness" Value="1" />
    </ControlTheme>
    <ControlTheme x:Key="SharedWindowShadow" TargetType="Border" BasedOn="{StaticResource SharedWindowFrame}">
      <Setter Property="Background" Value="{StaticResource ShellFrameBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource ShellBorderBrush}" />
      <Setter Property="IsHitTestVisible" Value="False" />
      <Setter Property="Effect">
        <Setter.Value />
      </Setter>
      <Setter Property="BoxShadow" Value="0 10 32 0 #BF000000" />
    </ControlTheme>
    <ControlTheme x:Key="SharedWindowHighlight" TargetType="Border">
      <Setter Property="CornerRadius" Value="27" />
      <Setter Property="BorderBrush" Value="#14FFFFFF" />
      <Setter Property="BorderThickness" Value="1,1,0,0" />
      <Setter Property="Padding" Value="14" />
    </ControlTheme>
    <ControlTheme x:Key="SharedCard" TargetType="Border">
      <Setter Property="CornerRadius" Value="20" />
      <Setter Property="Background" Value="{StaticResource ShellCardBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource ShellCardBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="14" />
    </ControlTheme>
    <ControlTheme x:Key="WindowsCloseButton" TargetType="Button">
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="24" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="5">
              <Viewbox Width="9" Height="9" Stretch="Uniform">
                <Canvas Width="10" Height="10">
                  <Path x:Name="Glyph" Data="M1 1 L9 9 M9 1 L1 9" Stroke="#99FFFFFF" StrokeThickness="1.3" StrokeLineCap="Round" />
                </Canvas>
              </Viewbox>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Setter Property="FontWeight" Value="Normal" />
      <Style Selector="^:pointerover /template/ Border#Bg">
        <Setter Property="Background" Value="#E81123" />
      </Style>
      <Style Selector="^:pointerover /template/ Path#Glyph">
        <Setter Property="Stroke" Value="White" />
      </Style>
      <Style Selector="^:pressed /template/ Border#Bg">
        <Setter Property="Background" Value="#BA141A" />
      </Style>
      <Style Selector="^:pressed /template/ Path#Glyph">
        <Setter Property="Stroke" Value="White" />
      </Style>
    </ControlTheme>
    <ControlTheme x:Key="WindowsMinimizeButton" TargetType="Button">
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="24" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="5">
              <Viewbox Width="9" Height="9" Stretch="Uniform">
                <Canvas Width="10" Height="10">
                  <Path x:Name="Glyph" Data="M0 5 L10 5" Stroke="#99FFFFFF" StrokeThickness="1.3" StrokeLineCap="Round" />
                </Canvas>
              </Viewbox>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Setter Property="FontWeight" Value="Normal" />
      <Style Selector="^:pointerover /template/ Border#Bg">
        <Setter Property="Background" Value="#1FFFFFFF" />
      </Style>
      <Style Selector="^:pointerover /template/ Path#Glyph">
        <Setter Property="Stroke" Value="White" />
      </Style>
      <Style Selector="^:pressed /template/ Border#Bg">
        <Setter Property="Background" Value="#30FFFFFF" />
      </Style>
      <Style Selector="^:pressed /template/ Path#Glyph">
        <Setter Property="Stroke" Value="White" />
      </Style>
    </ControlTheme>
    <ControlTheme x:Key="SegmentButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#8CFFFFFF" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Brd" Background="{TemplateBinding Background}" CornerRadius="12" Padding="0,5">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style Selector="^:pointerover /template/ Border#Brd">
        <Setter Property="Background" Value="#15FFFFFF" />
      </Style>
      <Style Selector="^:pointerover">
        <Setter Property="Foreground" Value="#E5FFFFFF" />
      </Style>
      <Style Selector="^:disabled">
        <Setter Property="Foreground" Value="#35FFFFFF" />
      </Style>
      <Style Selector="^:disabled">
        <Setter Property="Cursor" Value="Arrow" />
      </Style>
    </ControlTheme>
    <ControlTheme x:Key="SegmentButtonActive" TargetType="Button" BasedOn="{StaticResource SegmentButton}">
      <Setter Property="Background" Value="#2BFFFFFF" />
      <Setter Property="Foreground" Value="#FFFFFF" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Brd" Background="{TemplateBinding Background}" CornerRadius="12" Padding="0,5">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </ControlTheme>
    <ControlTheme x:Key="IOSGreenSwitch" TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Border x:Name="Track" Width="42" Height="24" CornerRadius="12" Background="#3D3D42">
              <Canvas Width="42" Height="24">
                <Ellipse x:Name="Thumb" Width="20" Height="20" Fill="#FFFFFF" Canvas.Top="2" Canvas.Left="2">
                                    </Ellipse>
              </Canvas>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style Selector="^:checked /template/ Ellipse#Thumb">
        <Setter Property="Canvas.Left" Value="20" />
      </Style>
      <Style Selector="^ /template/ Ellipse#Thumb">
        <Setter Property="Transitions">
          <Transitions>
            <DoubleTransition Property="Canvas.Left" Duration="0:0:0.25" />
          </Transitions>
        </Setter>
      </Style>
      <Style Selector="^:checked /template/ Border#Track">
        <Setter Property="Background" Value="#30D158" />
      </Style>
      <Style Selector="^:disabled /template/ Border#Track">
        <Setter Property="Opacity" Value="0.4" />
      </Style>
    </ControlTheme>
    <ControlTheme x:Key="IOSBlueSwitch" TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Border x:Name="Track" Width="42" Height="24" CornerRadius="12" Background="#3D3D42">
              <Canvas Width="42" Height="24">
                <Ellipse x:Name="Thumb" Width="20" Height="20" Fill="#FFFFFF" Canvas.Top="2" Canvas.Left="2">
                                    </Ellipse>
              </Canvas>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style Selector="^:checked /template/ Ellipse#Thumb">
        <Setter Property="Canvas.Left" Value="20" />
      </Style>
      <Style Selector="^ /template/ Ellipse#Thumb">
        <Setter Property="Transitions">
          <Transitions>
            <DoubleTransition Property="Canvas.Left" Duration="0:0:0.25" />
          </Transitions>
        </Setter>
      </Style>
      <Style Selector="^:checked /template/ Border#Track">
        <Setter Property="Background" Value="#0A84FF" />
      </Style>
      <Style Selector="^:disabled /template/ Border#Track">
        <Setter Property="Opacity" Value="0.4" />
      </Style>
    </ControlTheme>
    <ControlTheme x:Key="ApplePillButton" TargetType="Button">
      <Setter Property="Height" Value="38" />
      <Setter Property="Background" Value="#0FFFFFFF" />
      <Setter Property="BorderBrush" Value="#0AFFFFFF" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="#D9FFFFFF" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="16">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style Selector="^:pointerover /template/ Border#Bg">
        <Setter Property="Background" Value="#1CFFFFFF" />
      </Style>
      <Style Selector="^:pressed /template/ Border#Bg">
        <Setter Property="Background" Value="#14FFFFFF" />
      </Style>
      <Style Selector="^:pressed /template/ Border#Bg">
        <Setter Property="RenderTransform">
          <Setter.Value>
            <ScaleTransform ScaleX="0.97" ScaleY="0.97" />
          </Setter.Value>
        </Setter>
      </Style>
      <Style Selector="^:disabled /template/ Border#Bg">
        <Setter Property="Opacity" Value="0.4" />
      </Style>
      <Style Selector="^:disabled">
        <Setter Property="Cursor" Value="Arrow" />
      </Style>
    </ControlTheme>
    <ControlTheme x:Key="ApplePillButtonDanger" TargetType="Button" BasedOn="{StaticResource ApplePillButton}">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="16">
              <ContentPresenter x:Name="Content" HorizontalAlignment="Center" VerticalAlignment="Center" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style Selector="^:pointerover /template/ Border#Bg">
        <Setter Property="Background" Value="#25FF453A" />
      </Style>
      <Style Selector="^:pointerover /template/ Border#Bg">
        <Setter Property="BorderBrush" Value="#50FF453A" />
      </Style>
      <Style Selector="^:pointerover">
        <Setter Property="Foreground" Value="#FF6961" />
      </Style>
      <Style Selector="^:pressed /template/ Border#Bg">
        <Setter Property="Background" Value="#35FF453A" />
      </Style>
      <Style Selector="^:pressed">
        <Setter Property="Foreground" Value="#FF6961" />
      </Style>
      <Style Selector="^:disabled /template/ Border#Bg">
        <Setter Property="Opacity" Value="0.4" />
      </Style>
      <Style Selector="^:disabled">
        <Setter Property="Cursor" Value="Arrow" />
      </Style>
    </ControlTheme>
    <ControlTheme x:Key="PrimaryActionButton" TargetType="Button">
      <Setter Property="Height" Value="36" />
      <Setter Property="Background" Value="#17FFFFFF" />
      <Setter Property="BorderBrush" Value="#10FFFFFF" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="#F3F4F6" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="13">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style Selector="^:pointerover /template/ Border#Bg">
        <Setter Property="Background" Value="#25FFFFFF" />
      </Style>
      <Style Selector="^:pressed /template/ Border#Bg">
        <Setter Property="Background" Value="#14FFFFFF" />
      </Style>
      <Style Selector="^:pressed /template/ Border#Bg">
        <Setter Property="RenderTransform">
          <Setter.Value>
            <ScaleTransform ScaleX="0.985" ScaleY="0.985" />
          </Setter.Value>
        </Setter>
      </Style>
      <Style Selector="^:disabled /template/ Border#Bg">
        <Setter Property="Opacity" Value="0.4" />
      </Style>
      <Style Selector="^:disabled">
        <Setter Property="Cursor" Value="Arrow" />
      </Style>
    </ControlTheme>
    <ControlTheme x:Key="InputSlider" TargetType="Slider">
      <Setter Property="Height" Value="22" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Slider">
            <Grid>
              <Border Height="4" CornerRadius="2" Background="#30FFFFFF" VerticalAlignment="Center" Margin="8,0" />
              <Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="{TemplateBinding IsDirectionReversed}" Value="{Binding Value,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay}">
                <Track.DecreaseButton>
                  <RepeatButton Focusable="False">
                    <RepeatButton.Template>
                      <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent" />
                      </ControlTemplate>
                    </RepeatButton.Template>
                  </RepeatButton>
                </Track.DecreaseButton>
                <Track.Thumb>
                  <Thumb Width="16" Height="16">
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Ellipse Fill="#F0F1F3" Stroke="#50FFFFFF" />
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
                <Track.IncreaseButton>
                  <RepeatButton Focusable="False">
                    <RepeatButton.Template>
                      <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent" />
                      </ControlTemplate>
                    </RepeatButton.Template>
                  </RepeatButton>
                </Track.IncreaseButton>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </ControlTheme>
    <ControlTheme x:Key="GhostRowButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bg" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
              <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Setter Property="FontWeight" Value="Normal" />
      <Style Selector="^:pointerover /template/ Border#Bg">
        <Setter Property="Background" Value="#0AFFFFFF" />
      </Style>
    </ControlTheme>
    <ControlTheme x:Key="CompactButton" TargetType="Button">
      <Setter Property="Background" Value="#1CFFFFFF" />
      <Setter Property="Foreground" Value="#E5FFFFFF" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="10,5" />
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Setter Property="FontWeight" Value="Normal" />
      <Style Selector="^:pointerover /template/ Border#Bg">
        <Setter Property="Background" Value="#2CFFFFFF" />
      </Style>
      <Style Selector="^:disabled /template/ Border#Bg">
        <Setter Property="Opacity" Value="0.4" />
      </Style>
    </ControlTheme>
    <ControlTheme x:Key="LanguageButtonStyle" TargetType="Button">
      <Setter Property="Background" Value="#0CFFFFFF" />
      <Setter Property="BorderBrush" Value="#16FFFFFF" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="2">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Setter Property="FontWeight" Value="Normal" />
      <Style Selector="^:pointerover /template/ Border#Frame">
        <Setter Property="Background" Value="#18FFFFFF" />
      </Style>
      <Style Selector="^:pressed /template/ Border#Frame">
        <Setter Property="Opacity" Value="0.75" />
      </Style>
      <Style Selector="^:disabled /template/ Border#Frame">
        <Setter Property="Opacity" Value="0.45" />
      </Style>
    </ControlTheme>
    <ControlTheme x:Key="QuietButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#8CFFFFFF" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="6,4" />
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Setter Property="FontWeight" Value="Normal" />
      <Style Selector="^:pointerover /template/ Border#Bg">
        <Setter Property="Background" Value="#14FFFFFF" />
      </Style>
      <Style Selector="^:pointerover">
        <Setter Property="Foreground" Value="White" />
      </Style>
    </ControlTheme>
    <ControlTheme x:Key="ShellScrollBar" TargetType="ScrollBar" BasedOn="{StaticResource {x:Type ScrollBar}}">
      <Setter Property="Width" Value="5" />
      <Setter Property="Background" Value="Transparent" />
    </ControlTheme>
    <ControlTheme x:Key="SettingsTabs" TargetType="TabControl">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabControl">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <Border Background="#0DFFFFFF" CornerRadius="13" Margin="0,0,0,14" Padding="3">
                <ItemsPresenter Name="PART_ItemsPresenter" />
              </Border>
              <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Row="1" Content="{TemplateBinding SelectedContent}" ContentTemplate="{TemplateBinding SelectedContentTemplate}" />
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </ControlTheme>
    <ControlTheme x:Key="SettingsTab" TargetType="TabItem">
      <Setter Property="Foreground" Value="#99FFFFFF" />
      <Setter Property="Padding" Value="18,8" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabItem">
            <Border x:Name="TabBg" CornerRadius="10" Padding="{TemplateBinding Padding}" Background="Transparent">
              <ContentPresenter Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style Selector="^:selected /template/ Border#TabBg">
        <Setter Property="Background" Value="#24FFFFFF" />
      </Style>
      <Style Selector="^:selected">
        <Setter Property="Foreground" Value="White" />
      </Style>
      <Style Selector="^:pointerover">
        <Setter Property="Foreground" Value="White" />
      </Style>
    </ControlTheme>
    <ControlTheme x:Key="DarkComboItem" TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
      <Setter Property="Foreground" Value="#EEEEEE" />
      <Setter Property="Padding" Value="10,7" />
    </ControlTheme>
    <ControlTheme x:Key="DarkCombo" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
      <Setter Property="Foreground" Value="#EEEEEE" />
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="CornerRadius" Value="13" />
      <Setter Property="Background" Value="#17FFFFFF" />
      <Setter Property="BorderBrush" Value="#10FFFFFF" />
      <Setter Property="Padding" Value="12,7" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="FontWeight" Value="Normal" />
    </ControlTheme>
  </Window.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="16">
      <Border Width="356" Theme="{StaticResource SharedWindowShadow}" />
      <Border Width="356" Theme="{StaticResource SharedWindowFrame}">
        <Border Theme="{StaticResource SharedWindowHighlight}">
          <StackPanel>
            <Grid x:Name="DragHeader" Background="Transparent" Margin="2,0,2,8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="DS5Link" FontSize="13" FontWeight="SemiBold" Foreground="#E5FFFFFF" />
              </StackPanel>
              <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <Button x:Name="LanguageButton" Content="RU" Width="34" Height="22" FontSize="11" FontWeight="Normal" Foreground="#CCFFFFFF" Margin="0,0,8,0" Click="ToggleLanguage" Theme="{StaticResource LanguageButtonStyle}" ToolTip.Tip="RU / EN" AutomationProperties.Name="RU / EN" />
                  <Button x:Name="MinimizeBtn" Click="MinimizeWindow" Theme="{StaticResource WindowsMinimizeButton}" ToolTip.Tip="{local:Tr Key=36c25d9ffcfd}" />
                  <Button x:Name="CloseBtn" Click="CloseWindow" Margin="2,0,0,0" Theme="{StaticResource WindowsCloseButton}" ToolTip.Tip="{local:Tr Key=a7a4033657e8}" />
                </StackPanel>
              </StackPanel>
            </Grid>
            <Border CornerRadius="20" Background="#0EFFFFFF" BorderBrush="#12FFFFFF" BorderThickness="1" Padding="14" Margin="0,0,0,10">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <Border Width="48" Height="48" CornerRadius="15" BorderBrush="#15FFFFFF" BorderThickness="1">
                    <Border.Background>
                      <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#1AFFFFFF" Offset="0" />
                        <GradientStop Color="#08FFFFFF" Offset="1" />
                      </LinearGradientBrush>
                    </Border.Background>
                    <Image x:Name="ControllerArtwork" Width="44" Height="44" Stretch="Uniform" RenderOptions.BitmapInterpolationMode="HighQuality" Source="avares://DS5Link/Assets/DualSense-card.png">
                                        </Image>
                  </Border>
                  <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="DualSense" FontSize="16" FontWeight="SemiBold" Foreground="White" />
                    <Border x:Name="StatusBadge" CornerRadius="10" Background="#10FFFFFF" BorderBrush="#12FFFFFF" BorderThickness="1" Padding="8,2.5" Margin="0,4,0,0" HorizontalAlignment="Left">
                      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="StatusDot" Width="6" Height="6" Fill="#30D158" Margin="0,0,5,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="BadgeText" Text="{local:Tr Key=074415c7fee7}" FontSize="11" FontWeight="Normal" Foreground="#C4FFFFFF" VerticalAlignment="Center" />
                      </StackPanel>
                    </Border>
                  </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="BatteryText" Text="85%" FontSize="15" FontWeight="Normal" Foreground="White" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <local:BatteryGauge x:Name="BatteryIndicator" Width="29" Height="14" VerticalAlignment="Center" /></StackPanel>
                  <TextBlock x:Name="BatterySubtext" Text="{local:Tr Key=f14ddcab3d6d}" FontSize="11" FontWeight="Normal" Foreground="#30D158" HorizontalAlignment="Right" Margin="0,3,0,0" />
                </StackPanel>
              </Grid>
            </Border>
            <Border CornerRadius="20" Background="#0EFFFFFF" BorderBrush="#12FFFFFF" BorderThickness="1" Padding="14" Margin="0,0,0,10">
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Border x:Name="EmuBadge" Width="32" Height="32" CornerRadius="16" Background="#0A84FF">
                    <Viewbox Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                      <Canvas Width="24" Height="24">
                        <Path Data="M12 2v14 M15 5l-3-3-3 3 M12 13 L7 9V6 M12 11 l5-3V6" Stroke="White" StrokeThickness="2.2" StrokeLineCap="Round" />
                        <Ellipse Canvas.Left="9" Canvas.Top="16" Width="6" Height="6" Stroke="White" StrokeThickness="2.2" />
                        <Ellipse Canvas.Left="6" Canvas.Top="4" Width="2" Height="2" Fill="White" />
                        <Rectangle Canvas.Left="16" Canvas.Top="4" Width="2" Height="2" Fill="White" />
                      </Canvas>
                    </Viewbox>
                  </Border>
                  <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="EmuTitle" Text="{local:Tr Key=36c85c68e9c8}" FontSize="13" FontWeight="SemiBold" Foreground="White" />
                  </StackPanel>
                  <CheckBox x:Name="MainEmuSwitch" Grid.Column="2" VerticalAlignment="Center" Click="MainEmuSwitch_Click" Theme="{StaticResource IOSBlueSwitch}" ToolTip.Tip="{local:Tr Key=6b4c199ca1e5}" />
                </Grid>
                <Border CornerRadius="14" Background="#50000000" BorderBrush="#0AFFFFFF" BorderThickness="1" Padding="3" Margin="0,11,0,0">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="SegmentOff" Grid.Column="0" Content="{local:Tr Key=70f71197033b}" Click="SelectSegment_Off" Theme="{StaticResource SegmentButton}" />
                    <Button x:Name="SegmentPS5" Grid.Column="1" Content="PS5" Click="SelectSegment_PS5" Theme="{StaticResource SegmentButtonActive}" />
                    <Button x:Name="SegmentXInput" Grid.Column="2" Content="Xbox" Click="SelectSegment_Xbox" Theme="{StaticResource SegmentButton}" ToolTip.Tip="Xbox 360 / XInput" />
                  </Grid>
                </Border>
                <Button x:Name="ToggleButton" Content="{local:Tr Key=5b4c74bc5e27}" Margin="0,11,0,0" Click="ToggleBridge" Theme="{StaticResource PrimaryActionButton}" />
                <Button x:Name="FixHidHideButton" Content="{local:Tr Key=c106c133023f}" Margin="0,8,0,0" Click="FixHidHide" Theme="{StaticResource PrimaryActionButton}" IsVisible="False" />
              </StackPanel>
            </Border>
            <Grid Margin="0,0,0,10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Button x:Name="ReconnectButton" Grid.Column="0" Click="ReconnectBridge" Theme="{StaticResource ApplePillButton}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <Viewbox Width="14" Height="14" Stretch="Uniform" Margin="0,0,5,0">
                    <Canvas Width="24" Height="24" RenderTransformOrigin="50.0%,50.0%">
                      <Canvas.RenderTransform>
                        <RotateTransform Angle="0" />
                      </Canvas.RenderTransform>
                      <Path Data="M21 12a9 9 0 0 0-9-9 9.75 9.75 0 0 0-6.74 2.74L3 8" Stroke="#D9FFFFFF" StrokeThickness="2" StrokeLineCap="Round" />
                      <Path Data="M3 3v5h5" Stroke="#D9FFFFFF" StrokeThickness="2" StrokeLineCap="Round" />
                      <Path Data="M3 12a9 9 0 0 0 9 9 9.75 9.75 0 0 0 6.74-2.74L21 16" Stroke="#D9FFFFFF" StrokeThickness="2" StrokeLineCap="Round" />
                      <Path Data="M16 16h5v5" Stroke="#D9FFFFFF" StrokeThickness="2" StrokeLineCap="Round" />
                    </Canvas>
                  </Viewbox>
                  <TextBlock Text="{local:Tr Key=67c06a6c012f}" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button x:Name="DisconnectButton" Grid.Column="2" Click="DisconnectController" Theme="{StaticResource ApplePillButtonDanger}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <Viewbox Width="14" Height="14" Stretch="Uniform" Margin="0,0,5,0">
                    <Canvas Width="24" Height="24">
                      <Path Data="M12 2v10" Stroke="#D9FFFFFF" StrokeThickness="2" StrokeLineCap="Round" />
                      <Path Data="M18.4 6.6a9 9 0 1 1-12.77.04" Stroke="#D9FFFFFF" StrokeThickness="2" StrokeLineCap="Round" />
                    </Canvas>
                  </Viewbox>
                  <TextBlock Text="{local:Tr Key=8945e126853d}" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </Grid>
            <Border CornerRadius="20" Background="#0EFFFFFF" BorderBrush="#12FFFFFF" BorderThickness="1" Margin="0,0,0,10">
              <Button x:Name="InputSettingsButton" Click="ToggleInputSettings" Height="54" Padding="14,0" Theme="{StaticResource GhostRowButton}">
                <Grid>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{local:Tr Key=ef1b6a12a28e}" Foreground="#F0F1F3" />
                    <TextBlock Text="{local:Tr Key=82462183aa82}" FontSize="11.5" Foreground="#99FFFFFF" Margin="0,3,0,0" />
                  </StackPanel>
                  <TextBlock Text="↗" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#B8FFFFFF" FontSize="17" />
                </Grid>
              </Button>
            </Border>
            <Border CornerRadius="20" Background="#0EFFFFFF" BorderBrush="#12FFFFFF" BorderThickness="1" Margin="0,0,0,10">
              <StackPanel>
                <Grid Height="44" Margin="14,0">
                  <TextBlock Text="{local:Tr Key=58e294f089bd}" FontSize="13" Foreground="#F0F1F3" VerticalAlignment="Center" />
                  <CheckBox x:Name="StartupSwitch" HorizontalAlignment="Right" VerticalAlignment="Center" Theme="{StaticResource IOSGreenSwitch}" />
                </Grid>
                <Border Height="1" Background="#0FFFFFFF" />
                <Grid Height="44" Margin="14,0">
                  <TextBlock Text="{local:Tr Key=c98914a14377}" FontSize="13" Foreground="#F0F1F3" VerticalAlignment="Center" />
                  <CheckBox x:Name="AutoDisconnectSwitch" IsCheckedChanged="ToggleAutoDisconnect" IsEnabled="False"
                            HorizontalAlignment="Right" VerticalAlignment="Center" Theme="{StaticResource IOSGreenSwitch}"
                            AutomationProperties.Name="{local:Tr Key=c98914a14377}" ToolTip.Tip="{local:Tr Key=b62dc4a5b620}" />
                </Grid>
                <Border Height="1" Background="#0FFFFFFF" />
                <Button x:Name="AdvancedButton" Click="ToggleAdvanced" Height="44" Padding="14,0" Theme="{StaticResource GhostRowButton}">
                  <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                      <TextBlock Text="{local:Tr Key=da4da4e3527c}" FontSize="13" Foreground="#F0F1F3" VerticalAlignment="Center" />
                    </StackPanel>
                    <Viewbox Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Right" VerticalAlignment="Center">
                      <Canvas Width="24" Height="24">
                        <Path x:Name="DisclosureChevron" Data="M6 9 L12 15 L18 9" Stroke="#73FFFFFF" StrokeThickness="2.2" RenderTransformOrigin="50.0%,50.0%" StrokeLineCap="Round">
                          <Path.RenderTransform>
                            <RotateTransform Angle="0" />
                          </Path.RenderTransform>
                        </Path>
                      </Canvas>
                    </Viewbox>
                  </Grid>
                </Button>
                <Border x:Name="DisclosurePanel" Background="Transparent" BorderBrush="#0DFFFFFF" BorderThickness="0,1,0,0" Padding="14,12" CornerRadius="0,0,20,20" IsVisible="False">
                  <StackPanel>
                    <Border x:Name="DiagnosticsPanel">
                      <StackPanel>
                        <Grid Margin="0,0,0,8">
                          <TextBlock Text="{local:Tr Key=43a7f10a3621}" FontSize="12" FontWeight="Normal" Foreground="#BBFFFFFF" />
                          <TextBlock x:Name="DiagnosticsUpdated" FontSize="11" Foreground="#55FFFFFF" HorizontalAlignment="Right" />
                        </Grid>
                        <Grid Margin="0,0,0,8">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                          </Grid.ColumnDefinitions>
                          <StackPanel x:Name="ConnectionMetrics" />
                          <StackPanel Grid.Column="2" x:Name="AudioMetrics" />
                        </Grid>
                        <TextBlock x:Name="DiagnosticError" Foreground="#E9B4A8" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8" IsVisible="False" />
                        <Border Height="1" Background="#0DFFFFFF" Margin="0,2,0,12" />
                        <TextBlock Text="{local:Tr Key=18e1009d6ab9}" FontSize="11" FontWeight="Normal" Foreground="#BBFFFFFF" Margin="0,0,0,8" />
                        <TextBlock x:Name="EventsEmpty" Text="{local:Tr Key=3d64c6af641f}" FontSize="11" Foreground="#A8FFFFFF" Margin="0,0,0,10" />
                        <ItemsControl x:Name="EventList" AutomationProperties.Name="{local:Tr Key=22d6be4e5625}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <Border Background="#07FFFFFF" CornerRadius="10" Padding="10,8" Margin="0,0,0,5" ToolTip.Tip="{Binding Detail}">
                                <StackPanel>
                                  <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                      <ColumnDefinition Width="10" />
                                      <ColumnDefinition Width="*" />
                                      <ColumnDefinition Width="Auto" />
                                      <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="5" Height="5" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                                        </Ellipse>
                                    <TextBlock Grid.Column="1" Text="{Binding Category}" FontSize="11" Foreground="#B8FFFFFF" />
                                    <TextBlock Grid.Column="2" Text="{Binding RepeatLabel}" FontSize="11" Foreground="#A8FFFFFF" Margin="0,0,6,0" />
                                    <TextBlock Grid.Column="3" Text="{Binding Time}" FontSize="11" Foreground="#A8FFFFFF" />
                                  </Grid>
                                  <TextBlock Text="{Binding Message}" FontSize="11" Foreground="#D9FFFFFF" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="44" />
                                </StackPanel>
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{local:Tr Key=d73f2250fc27}" FontSize="14" Foreground="#55FFFFFF" Margin="0,3,0,4" />
                        <Grid Margin="0,8,0,0">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <Button x:Name="ExportButton" Content="{local:Tr Key=56147afae454}" Click="SaveDiagnostics" FontSize="14" Theme="{StaticResource CompactButton}" />
                          <Button Grid.Column="1" Content="{local:Tr Key=cfbf342a295b}" Click="OpenDiagnosticsFolder" FontSize="14" Margin="6,0,0,0" Theme="{StaticResource CompactButton}" />
                          <Button Grid.Column="3" Content="{local:Tr Key=75cd24c315d4}" Click="ExitApplication" Theme="{StaticResource QuietButton}" />
                        </Grid>
                        <WrapPanel Orientation="Horizontal" Margin="0,8,0,0">
                          <Button Content="{local:Tr Key=45c6b329780b}" Click="RecoverController" FontSize="14" Margin="0,0,5,5" Theme="{StaticResource CompactButton}" />
                          <Button Content="{local:Tr Key=04cee37027b6}" Click="SelectController" FontSize="14" Margin="0,0,0,5" Theme="{StaticResource CompactButton}" />
                        </WrapPanel>
                        <TextBlock x:Name="DiagnosticsNotice" FontSize="14" Foreground="#E5E7EB" TextWrapping="Wrap" Margin="0,6,0,0" IsVisible="False" />
                      </StackPanel>
                    </Border>
                  </StackPanel>
                </Border>
              </StackPanel>
            </Border>
            <StackPanel IsVisible="False">
              <TextBlock x:Name="ConnectionText" />
              <TextBlock x:Name="SignalText" />
            </StackPanel>
            <Grid Margin="4,2,4,2">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="FooterStatus" Text="" FontSize="11" Foreground="#66FFFFFF" />
              <TextBlock x:Name="VersionText" Grid.Column="1" FontSize="11" Foreground="#66FFFFFF" />
            </Grid>
          </StackPanel>
        </Border>
      </Border>
    </Grid>
  </ScrollViewer>
</Window>
